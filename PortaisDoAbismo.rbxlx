			{ name = "Corte Fantasma", desc = "3 cortes espectrais em sequência.", kind = "projectile", visual = "blade", cd = 4, damage = 22, burst = 3, burstGap = 0.12, speed = 110, range = 60, size = 1.4, pierce = 1 },
