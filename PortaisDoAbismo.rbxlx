        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Enemies</string>
            <string name="Source"><![CDATA[-- Arquétipos de inimigos. Cada masmorra dá nome/cor própria a eles (ver Dungeons.luau)
-- e multiplica vida/dano.
return {
	chaser = { hp = 50, speed = 13, damage = 8, reach = 2, attackCd = 1, size = Vector3.new(2.5, 3.5, 2), xp = 2, gold = 1 },
	runner = { hp = 28, speed = 18, damage = 5, reach = 2, attackCd = 0.8, size = Vector3.new(2, 2.4, 3), xp = 1, gold = 1 },
	archer = {
		hp = 40,
		speed = 11,
		damage = 9,
		attackCd = 2.4,
		size = Vector3.new(2, 3.6, 1.6),
		ranged = true,
		range = 38,
		projectileSpeed = 45,
		xp = 3,
		gold = 2,
	},
	brute = { hp = 220, speed = 9, damage = 18, reach = 3, attackCd = 1.6, size = Vector3.new(4, 6, 3), xp = 8, gold = 4 },
	-- base de todos os chefes; vida, tamanho e habilidades vêm da masmorra
	boss = { hp = 4000, speed = 12, damage = 22, reach = 4, attackCd = 1.4, skillCd = 5, size = Vector3.new(7, 10, 6), xp = 0, gold = 50 },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Game</string>
            <string name="Source"><![CDATA[-- Configurações gerais do jogo
return {
	GameName = "Portais do Abismo", -- nome provisório, troque à vontade
	MaxPartySize = 4,
	QueueCountdown = 10, -- segundos no portal antes de entrar
	MaxPowerSlots = 4, -- quantos poderes diferentes cabem numa run
	MaxAliveEnemies = 60,
	SpawnGroupSize = 6, -- inimigos por leva dentro de uma onda
	SpawnGroupInterval = 1, -- segundos entre levas
	ArenaSpacing = 1000, -- distância entre arenas de runs simultâneas
	ReturnToLobbyDelay = 8,

	BasicAttack = {
		damage = 20,
		range = 11,
		cooldown = 0.3, -- intervalo mínimo entre golpes
		comboReset = 0.9, -- sem atacar por esse tempo, o combo volta ao 1º golpe
		color = Color3.fromRGB(255, 235, 190),
		-- cada golpe do combo: multiplicador de dano/alcance, abertura do cone (dot), empurrão, atraso do acerto
		combo = {
			{ damage = 1, range = 1, arc = 0.35, knockback = 15, hitDelay = 0.08 },
			{ damage = 1.1, range = 1, arc = 0.35, knockback = 15, hitDelay = 0.08 },
			{ damage = 1.9, range = 1.25, arc = -0.2, knockback = 45, hitDelay = 0.14, slam = true },
		},
	},

	-- Arma do jogador. Se existir ReplicatedStorage.Assets.Weapons[Model], ela é usada;
	-- senão o jogo monta uma espada com Parts.
	-- GripOffset ajusta a posição/rotação do modelo importado na mão (mexa aqui se ficar torta).
	Weapon = {
		Model = "Sword",
		Length = 4.5, -- o modelo importado é escalado para ter esse comprimento
		GripOffset = CFrame.Angles(0, 0, 0),
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Powers</string>
            <string name="Source"><![CDATA[--[[
	Poderes. Cada poder tem 4 níveis (tiers):
	  1, 2, 3  -> habilidades que disparam SOZINHAS quando a recarga acaba (estilo 20 Minutes Till Dawn)
	  4        -> ULTIMATE, ativada pelo jogador com a tecla do slot (1-4)

	Cada pegar do mesmo poder no level up libera o próximo tier. Os tiers anteriores continuam ativos.

	`kind` define o comportamento (implementado em PowerService):
	  projectile  damage, count, spread, speed, range, size, pierce, homing, burst, burstGap, jitter, explode, slow, slowTime
	  nova        damage, radius, knockback, pull, slow, slowTime, freeze, lifesteal, atTarget
	  strike      damage, radius, count, delay, interval, area   (cai do céu com aviso no chão)
	  zone        dps, radius, duration, follow, pull, slow
	  orbit       damage, count, radius, duration, spin
	  line        damage, length, width
	  beam        dps, length, width, duration
	  chain       damage, jumps, range
	  summon      damage, count, duration, speed, explode, explodeRadius
	  shield      absorb, duration, reflect, knockback, radius
	  heal        amount, regen, duration, invuln
	  buff        damageMult, duration, auraDps, radius
	`cd` = recarga em segundos.
]]

local Powers = {}

Powers.List = {
	{
		id = "soul_swords",
		name = "Espadas Almas",
		color = Color3.fromRGB(80, 160, 255),
