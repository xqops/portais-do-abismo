      <Item class="LocalScript" referent="28">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Ponto de entrada do cliente
local Controllers = script:WaitForChild("Controllers")

local VFX = require(Controllers:WaitForChild("VFX"))
VFX.Init()
require(Controllers:WaitForChild("Animator")).Init(VFX)
require(Controllers:WaitForChild("Feedback")).Init(VFX)
require(Controllers:WaitForChild("UI")).Init()
require(Controllers:WaitForChild("Input")).Init()
]]></string>
        </Properties>
        <Item class="Folder" referent="29">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">Animator</string>
              <string name="Source"><![CDATA[--[[
	Animações feitas por código (não precisam de upload de Animation):
	- Golpes de espada dos jogadores: gira ombro, tronco e a junta da arma (WeaponGrip) + rastro do corte.
	- Monstros: balanço ao andar, investida ao atacar, recuo e piscada branca ao levar dano,
	  surgir do chão e cair ao morrer. Funciona com o boneco de blocos e com modelos importados.
	Depois dá para trocar por Animations de verdade (Animation Editor / Moon Animator) mantendo isto como reserva.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")

local Animator = {}

local player = Players.LocalPlayer
local VFX -- injetado no Init

local WHITE = Color3.new(1, 1, 1)

-- golpes do combo: ombro (yaw = esquerda/direita, pitch = levantar), giro do tronco e
-- `blade` = quanto a lâmina gira para ficar alinhada com o braço (0 = apontando para a frente)
local SWINGS = {
	{ from = { yaw = -80, pitch = 95, waist = -30, blade = 1 }, to = { yaw = 70, pitch = 75, waist = 35, blade = 1 }, time = 0.15, arc = { -85, 85 } },
	{ from = { yaw = 60, pitch = 80, waist = 30, blade = 1 }, to = { yaw = -85, pitch = 95, waist = -35, blade = 1 }, time = 0.15, arc = { 85, -85 } },
	{ from = { yaw = -15, pitch = 200, waist = 0, blade = 0.7 }, to = { yaw = -15, pitch = 30, waist = 0, blade = 0.7 }, time = 0.18, arc = { 110, -15 }, vertical = true },
}
local REST = { yaw = 0, pitch = 0, waist = 0, blade = 0 }

local bases = setmetatable({}, { __mode = "k" }) -- C0 original de cada junta
local playing = setmetatable({}, { __mode = "k" }) -- personagem -> token da animação atual

local function base(motor)
	if not bases[motor] then
		bases[motor] = motor.C0
	end
	return bases[motor]
end

local function getRig(character)
	local arm = character:FindFirstChild("RightUpperArm")
	local torso = character:FindFirstChild("UpperTorso")
	local hand = character:FindFirstChild("RightHand")
	local shoulder = arm and arm:FindFirstChild("RightShoulder")
	if not shoulder then
		return nil -- só R15
	end
	return {
		shoulder = shoulder,
		waist = torso and torso:FindFirstChild("Waist"),
		grip = hand and hand:FindFirstChild("WeaponGrip"),
	}
end

local function lerpPose(a, b, t)
	return {
		yaw = a.yaw + (b.yaw - a.yaw) * t,
		pitch = a.pitch + (b.pitch - a.pitch) * t,
		waist = a.waist + (b.waist - a.waist) * t,
		blade = a.blade + (b.blade - a.blade) * t,
	}
end

local function applyPose(rig, pose)
	rig.shoulder.C0 = base(rig.shoulder) * CFrame.Angles(0, math.rad(pose.yaw), 0) * CFrame.Angles(math.rad(pose.pitch), 0, 0)
	if rig.waist then
		rig.waist.C0 = base(rig.waist) * CFrame.Angles(0, math.rad(pose.waist), 0)
	end
	if rig.grip then
		rig.grip.C0 = base(rig.grip) * CFrame.Angles(math.rad(-90 * pose.blade), 0, 0)
	end
end

local function easeOut(t)
	return 1 - (1 - t) ^ 3
end

-- rastro brilhante que acompanha o arco do golpe
local function slashTrail(root, swing, dir, range, color)
	local tracer = Instance.new("Part")
	tracer.Anchored = true
	tracer.CanCollide = false
	tracer.CanQuery = false
	tracer.CanTouch = false
	tracer.Transparency = 1
	tracer.Size = Vector3.one * 0.2
	tracer.Parent = workspace

	local width = 1.3
	local side = dir:Cross(Vector3.yAxis)
	local a0 = Instance.new("Attachment")
	local a1 = Instance.new("Attachment")
	a0.Parent = tracer
	a1.Parent = tracer
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(WHITE, color)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.5, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new(1, 0.3)
	trail.Lifetime = 0.16
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.MinLength = 0
	trail.Parent = tracer

	local radius = range * 0.7
	local fromAngle, toAngle = math.rad(swing.arc[1]), math.rad(swing.arc[2])
	local function place(alpha)
		local angle = fromAngle + (toAngle - fromAngle) * easeOut(alpha)
		local center = root.Position + Vector3.new(0, 0.6, 0)
		local point
		if swing.vertical then
			point = center + (dir * math.cos(angle) + Vector3.yAxis * math.sin(angle)) * radius
			a0.Position = side * width
			a1.Position = -side * width
		else
			point = center + (CFrame.fromAxisAngle(Vector3.yAxis, angle) * dir) * radius
			a0.Position = Vector3.new(0, width, 0)
			a1.Position = Vector3.new(0, -width, 0)
		end
		tracer.CFrame = CFrame.new(point)
	end

	place(0)
	trail:Clear()
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local alpha = math.min(1, (os.clock() - start) / swing.time)
		place(alpha)
		if alpha >= 1 then
			connection:Disconnect()
			Debris:AddItem(tracer, trail.Lifetime + 0.05)
		end
	end)
end

function Animator.Swing(data)
	local swinger = data.player
	local character = swinger and swinger.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local swing = SWINGS[data.combo]
	if not root or not swing then
		return
	end
	local dir = Vector3.new(data.dir.X, 0, data.dir.Z)
	if dir.Magnitude < 0.01 then
		return
	end
	dir = dir.Unit

	if swinger == player then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
	end
	slashTrail(root, swing, dir, data.range, data.color)
	VFX.PlaySound(data.combo == 3 and VFX.Sounds.lunge or VFX.Sounds.slash, root.Position, 0.45, data.combo == 3 and 0.85 or 1)

	local rig = getRig(character)
	if not rig then
		return
	end
	local token = {}
	playing[character] = token
	local windup, hold, recover = 0.05, 0.05, 0.14
	local total = windup + swing.time + hold + recover
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if playing[character] ~= token or not character.Parent then
			connection:Disconnect()
			return
		end
		local t = os.clock() - start
		local pose
		if t < windup then
			pose = lerpPose(REST, swing.from, t / windup)
		elseif t < windup + swing.time then
			pose = lerpPose(swing.from, swing.to, easeOut((t - windup) / swing.time))
		elseif t < windup + swing.time + hold then
			pose = swing.to
		else
			pose = lerpPose(swing.to, REST, math.min(1, (t - windup - swing.time - hold) / recover))
		end
		applyPose(rig, pose)
		if t >= total then
			applyPose(rig, REST)
			playing[character] = nil
			connection:Disconnect()
		end
	end)
end

-- monstros ----------------------------------------------------------------------------------

local tracked = {}

local function track(model)
	if tracked[model] then
		return
	end
	local root = model:WaitForChild("HumanoidRootPart", 5)
	local joint = root and root:WaitForChild("Visual", 5)
	if not joint then
		return
	end
	local highlight = Instance.new("Highlight")
	highlight.FillColor = WHITE
	highlight.OutlineTransparency = 1
	highlight.FillTransparency = 0.2
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false
	highlight.Parent = model
	tracked[model] = {
		root = root,
		joint = joint,
		base = joint.C0,
		height = root.Size.Y,
		scale = math.clamp(root.Size.Y / 3.5, 0.6, 3),
		walk = math.random() * 10,
		spawnT = os.clock(),
		hit = model:GetAttribute("Hit") or 0,
		hitT = 0,
		attack = model:GetAttribute("Attack") or 0,
		attackT = 0,
		deadT = nil,
		highlight = highlight,
	}
end

local function stepEnemies(dt)
	local now = os.clock()
	for model, d in tracked do
		if not model.Parent or not d.joint.Parent then
			tracked[model] = nil
			continue
		end

		local hit = model:GetAttribute("Hit") or 0
		if hit ~= d.hit then
			d.hit = hit
			d.hitT = now
		end
		local attack = model:GetAttribute("Attack") or 0
		if attack ~= d.attack then
			d.attack = attack
			d.attackT = now
		end
		if model:GetAttribute("Dead") and not d.deadT then
			d.deadT = now
		end

		-- piscada branca rápida ao levar dano
		d.highlight.Enabled = now - d.hitT < 0.07 and not d.deadT

		local cf
		if d.deadT then
			local t = math.min(1, (now - d.deadT) / 0.45)
			cf = CFrame.new(0, -t * d.height * 0.4, 0) * CFrame.Angles(math.rad(85) * easeOut(t), 0, 0)
		else
			local velocity = d.root.AssemblyLinearVelocity
			local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
			local moving = math.min(speed / 8, 1)
			d.walk += dt * (6 + speed * 0.4) / d.scale
			local bob = math.abs(math.sin(d.walk)) * 0.35 * d.scale * moving
			local sway = math.sin(d.walk) * math.rad(9) * moving
			local breathe = math.sin(now * 2 + d.walk) * 0.05 * d.scale

			local lunge, tilt = 0, 0
			local attackT = (now - d.attackT) / 0.35
			if attackT < 1 then
				local curve = math.sin(attackT * math.pi)
				lunge = curve * 1.4 * d.scale
				tilt = curve * math.rad(18)
			end
			local recoil = math.max(0, 1 - (now - d.hitT) / 0.15)
			local rise = easeOut(math.min(1, (now - d.spawnT) / 0.45))

			cf = CFrame.new(0, bob + breathe - (1 - rise) * d.height, -lunge + recoil * 0.4 * d.scale)
				* CFrame.Angles(-tilt + recoil * math.rad(12), 0, sway)
		end
		d.joint.C0 = d.base * cf
	end
end

function Animator.Init(vfx)
	VFX = vfx
	VFX.On("swing", Animator.Swing)
	CollectionService:GetInstanceAddedSignal("Enemy"):Connect(function(model)
		task.spawn(track, model)
	end)
	for _, model in CollectionService:GetTagged("Enemy") do
		task.spawn(track, model)
	end
	RunService.RenderStepped:Connect(stepEnemies)
end

return Animator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Feedback</string>
              <string name="Source"><![CDATA[-- Números de dano flutuantes + faísca no ponto do acerto.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local Feedback = {}

local LIFETIME = 0.75
local VFX -- injetado no Init

local function showNumber(position, amount, color)
	VFX.HitSpark(position, color or Color3.new(1, 1, 1))

	-- Attachment no Terrain = ponto fixo no mundo para prender o BillboardGui
	local anchor = Instance.new("Attachment")
	anchor.Position = position
	anchor.Parent = workspace.Terrain

	-- golpes fortes aparecem maiores
	local big = amount >= 100
	local size = big and 110 or (amount >= 40 and 80 or 60)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(size, size * 0.4)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	gui.StudsOffsetWorldSpace = Vector3.new((math.random() - 0.5) * 2.5, 1, (math.random() - 0.5) * 2.5)
	gui.Adornee = anchor
	gui.Parent = anchor

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = big and (tostring(amount) .. "!") or tostring(amount)
	label.TextColor3 = big and Color3.fromRGB(255, 220, 90) or (color or Color3.new(1, 1, 1))
	label.TextStrokeTransparency = 0
	label.Parent = gui

	-- "pula" e depois sobe sumindo
	local scale = Instance.new("UIScale")
	scale.Scale = 1.6
	scale.Parent = label
	TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local info = TweenInfo.new(LIFETIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(gui, TweenInfo.new(LIFETIME), { StudsOffsetWorldSpace = gui.StudsOffsetWorldSpace + Vector3.new(0, 3.5, 0) }):Play()
	TweenService:Create(label, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, LIFETIME + 0.1)
end

function Feedback.Init(vfx)
	VFX = vfx
	Net.DamageNumber.OnClientEvent:Connect(showNumber)
end

return Feedback
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">Input</string>
              <string name="Source"><![CDATA[-- Controles: clique = ataque básico (segurar repete), Q = esquiva, 1-4 = ultimates.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local player = Players.LocalPlayer
local mouse = player:GetMouse()

local Input = {}

local DASH_COOLDOWN = 2.5
local DASH_SPEED = 85
local DASH_TIME = 0.18
local ATTACK_INTERVAL = 0.32 -- precisa ser >= BasicAttack.cooldown (Config/Game.luau)

local ULTIMATE_KEYS = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
}

local lastDash = 0
local attacking = false

local function getCharacter()
	local character = player.Character
	if not character then
		return nil, nil
	end
	return character:FindFirstChild("HumanoidRootPart"), character:FindFirstChildOfClass("Humanoid")
end

local function attack()
	local root, humanoid = getCharacter()
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	local direction = mouse.Hit.Position - root.Position
	if Vector3.new(direction.X, 0, direction.Z).Magnitude < 0.5 then
		direction = root.CFrame.LookVector
	end
	Net.BasicAttack:FireServer(direction)
end

local function dash()
	local root, humanoid = getCharacter()
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	local now = os.clock()
	if now - lastDash < DASH_COOLDOWN then
		return
	end
	lastDash = now

	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = root.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z).Unit

	local attachment = root:FindFirstChild("RootAttachment")
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "RootAttachment"
		attachment.Parent = root
	end
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VectorVelocity = direction * DASH_SPEED
	velocity.Parent = root
	task.delay(DASH_TIME, function()
		velocity:Destroy()
	end)
end

function Input.GetDashCooldown()
	return math.max(0, DASH_COOLDOWN - (os.clock() - lastDash)), DASH_COOLDOWN
end

function Input.Init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if attacking then
				return
			end
			attacking = true
			task.spawn(function()
				while attacking do
					attack()
					task.wait(ATTACK_INTERVAL)
				end
			end)
		elseif input.KeyCode == Enum.KeyCode.Q then
			dash()
		elseif ULTIMATE_KEYS[input.KeyCode] then
			Net.CastUltimate:FireServer(ULTIMATE_KEYS[input.KeyCode])
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			attacking = false
		end
	end)
end

return Input
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- HUD: perfil da conta, estado da run, slots de poder, barras de vida/XP,
-- painel de level up com 3 cartas e avisos na tela.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local player = Players.LocalPlayer

local UI = {}

local C = {
	panel = Color3.fromRGB(28, 22, 18),
	panelLight = Color3.fromRGB(58, 46, 36),
	gold = Color3.fromRGB(235, 190, 90),
	text = Color3.fromRGB(245, 235, 215),
	muted = Color3.fromRGB(170, 155, 135),
	hp = Color3.fromRGB(220, 60, 60),
	xp = Color3.fromRGB(90, 200, 255),
	shield = Color3.fromRGB(140, 220, 255),
	dark = Color3.fromRGB(16, 12, 10),
}
local FONT_TITLE = Enum.Font.GothamBlack
local FONT_BODY = Enum.Font.GothamBold

local KIND_BADGE = {
	new = "NOVO PODER",
	upgrade = "EVOLUÇÃO",
	ultimate = "ULTIMATE",
	stat = "ATRIBUTO",
}

-- helpers ----------------------------------------------------------------------

local function new(className, props, children)
	local instance = Instance.new(className)
	local parent = props.Parent
	props.Parent = nil
	for key, value in props do
		instance[key] = value
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	instance.Parent = parent
	return instance
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color, Thickness = thickness or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function text(props)
	props.BackgroundTransparency = 1
	props.TextColor3 = props.TextColor3 or C.text
	props.Font = props.Font or FONT_BODY
	props.TextSize = props.TextSize or 14
	return new("TextLabel", props)
end

local function makeBar(parent, size, position, color)
	local back = new("Frame", {
		Parent = parent,
		Size = size,
		Position = position,
		BackgroundColor3 = C.dark,
		BorderSizePixel = 0,
	}, { corner(4), stroke(C.gold, 1) })
	local fill = new("Frame", { Parent = back, Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0 }, { corner(4) })
	local label = text({ Parent = back, Size = UDim2.fromScale(1, 1), TextSize = 12, Text = "", ZIndex = 3 })
	return { back = back, fill = fill, label = label }
end

local function setBar(bar, ratio)
	bar.fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
end

local function formatTime(seconds)
	return string.format("%02d:%02d", math.floor(seconds / 60), math.floor(seconds % 60))
end

-- slot de poder ----------------------------------------------------------------

local function makeSlot(parent, index)
	local frame = new("Frame", {
		Parent = parent,
		Size = UDim2.fromOffset(120, 84),
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = index,
		ClipsDescendants = true,
	}, { corner(8) })
	local border = stroke(C.panelLight, 2)
	border.Parent = frame
	local strip = new("Frame", { Parent = frame, Size = UDim2.new(1, 0, 0, 5), BackgroundColor3 = C.panelLight, BorderSizePixel = 0 })
	local name = text({
		Parent = frame,
		Position = UDim2.fromOffset(8, 10),
		Size = UDim2.new(1, -30, 0, 18),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "Vazio",
		TextColor3 = C.muted,
	})
	text({
		Parent = frame,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, 9),
		Size = UDim2.fromOffset(18, 18),
		Font = FONT_TITLE,
		TextSize = 15,
		Text = tostring(index),
		TextColor3 = C.muted,
	})
	local pips = {}
	for i = 1, 4 do
		pips[i] = new("Frame", {
			Parent = frame,
			Position = UDim2.fromOffset(8 + (i - 1) * 26, 32),
			Size = UDim2.fromOffset(22, 6),
			BackgroundColor3 = C.dark,
			BorderSizePixel = 0,
		}, { corner(2) })
	end
	local ult = text({
		Parent = frame,
		Position = UDim2.fromOffset(8, 44),
		Size = UDim2.new(1, -16, 0, 34),
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
		TextColor3 = C.muted,
	})
	local cooldown = new("Frame", {
		Parent = frame,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
	})
	return { frame = frame, border = border, strip = strip, name = name, pips = pips, ult = ult, cooldown = cooldown }
end

local function updateSlot(slot, data)
	if not data then
		slot.name.Text = "Vazio"
		slot.name.TextColor3 = C.muted
		slot.strip.BackgroundColor3 = C.panelLight
		slot.border.Color = C.panelLight
		slot.ult.Text = ""
		slot.cooldown.Size = UDim2.fromScale(1, 0)
		for _, pip in slot.pips do
			pip.BackgroundColor3 = C.dark
		end
		return
	end
	slot.name.Text = data.name
	slot.name.TextColor3 = C.text
	slot.strip.BackgroundColor3 = data.color
	for i, pip in slot.pips do
		if i <= data.tier then
			pip.BackgroundColor3 = i == 4 and C.gold or data.color
		else
			pip.BackgroundColor3 = C.dark
		end
	end
	if data.ult then
		if data.ultCd > 0 then
			slot.ult.Text = string.format("ULT em %ds", math.ceil(data.ultCd))
			slot.ult.TextColor3 = C.muted
			slot.border.Color = data.color
			slot.cooldown.Size = UDim2.fromScale(1, data.ultCd / data.ultMax)
		else
			slot.ult.Text = "ULT PRONTA!\n" .. data.ult
			slot.ult.TextColor3 = C.gold
			slot.border.Color = C.gold
			slot.cooldown.Size = UDim2.fromScale(1, 0)
		end
	else
		slot.ult.Text = "Nv " .. data.tier .. "/4"
		slot.ult.TextColor3 = C.muted
		slot.border.Color = data.color
		slot.cooldown.Size = UDim2.fromScale(1, 0)
	end
end

-- construção da interface ----------------------------------------------------------

function UI.Init()
	local gui = new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- perfil (canto superior direito) ----------------------------------------------
	local profile = new("Frame", {
		Parent = gui,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		Size = UDim2.fromOffset(240, 74),
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.15,
	}, { corner(8), stroke(C.gold, 1.5) })
	local profileLevel = text({
		Parent = profile,
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(0.5, -12, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT_TITLE,
		TextSize = 16,
		TextColor3 = C.gold,
		Text = "NV 1",
	})
	local profileGold = text({
		Parent = profile,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 8),
		Size = UDim2.new(0.5, -12, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 15,
		Text = "0 ouro",
	})
	local accountBar = makeBar(profile, UDim2.new(1, -24, 0, 10), UDim2.fromOffset(12, 34), C.xp)
	local profileProgress = text({
		Parent = profile,
		Position = UDim2.fromOffset(12, 50),
		Size = UDim2.new(1, -24, 0, 16),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 12,
		TextColor3 = C.muted,
		Text = "Masmorras: 0",
	})

	-- dica do lobby ---------------------------------------------------------------
	local lobbyHint = text({
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(700, 24),
		TextSize = 15,
		TextStrokeTransparency = 0.4,
		Text = "Entre em um portal com seus amigos  ·  [Clique] atacar  ·  [Q] esquivar  ·  [1-4] ultimates",
	})

	-- HUD da run ------------------------------------------------------------------------
	local runFrame = new("Frame", { Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false })

	local top = new("Frame", {
		Parent = runFrame,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(520, 90),
		BackgroundTransparency = 1,
	})
	local dungeonLabel = text({
		Parent = top,
		Size = UDim2.new(1, 0, 0, 28),
		Font = FONT_TITLE,
		TextSize = 24,
		TextColor3 = C.gold,
		TextStrokeTransparency = 0.5,
	})
	local waveLabel = text({
		Parent = top,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 16,
		TextStrokeTransparency = 0.5,
	})
	local bossBar = makeBar(top, UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, 56), C.hp)
	bossBar.back.Visible = false

	local statsPanel = new("Frame", {
		Parent = runFrame,
		Position = UDim2.fromOffset(16, 70),
		Size = UDim2.fromOffset(170, 88),
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.25,
	}, {
		corner(8),
		stroke(C.panelLight, 1.5),
		new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingTop = UDim.new(0, 8) }),
		new("UIListLayout", { Padding = UDim.new(0, 2) }),
	})
	local function statLine(order)
		return text({
			Parent = statsPanel,
			LayoutOrder = order,
			Size = UDim2.new(1, -10, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextSize = 14,
		})
	end
	local timeLabel = statLine(1)
	local killsLabel = statLine(2)
	local goldLabel = statLine(3)
	local enemiesLabel = statLine(4)

	local bottom = new("Frame", {
		Parent = runFrame,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(560, 146),
		BackgroundTransparency = 1,
	})
	local slotsRow = new("Frame", { Parent = bottom, Size = UDim2.new(1, 0, 0, 84), BackgroundTransparency = 1 }, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 10),
		}),
	})
	local slots = {}
	for i = 1, 4 do
		slots[i] = makeSlot(slotsRow, i)
	end
	local hpBar = makeBar(bottom, UDim2.new(1, 0, 0, 20), UDim2.fromOffset(0, 94), C.hp)
	local shieldFill = new("Frame", {
		Parent = hpBar.back,
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.shield,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, { corner(4) })
	local levelLabel = text({
		Parent = bottom,
		Position = UDim2.fromOffset(0, 120),
		Size = UDim2.fromOffset(64, 22),
		Font = FONT_TITLE,
		TextSize = 18,
		TextColor3 = C.gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "NV 1",
	})
	local xpBar = makeBar(bottom, UDim2.new(1, -70, 0, 14), UDim2.fromOffset(70, 124), C.xp)

	-- flash de dano -----------------------------------------------------------------
	local hurtFlash = new("Frame", {
		Parent = gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.hp,
		BackgroundTransparency = 1,
		ZIndex = 5,
	})

	-- painel de level up ----------------------------------------------------------------
	local levelPanel = new("Frame", {
		Parent = gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		Visible = false,
		ZIndex = 10,
	})
	local levelTitle = text({
		Parent = levelPanel,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.14, 0),
		Size = UDim2.fromOffset(700, 40),
		Font = FONT_TITLE,
		TextSize = 34,
		TextColor3 = C.gold,
		TextStrokeTransparency = 0.4,
		Text = "SUBIU DE NÍVEL!",
	})
	text({
		Parent = levelPanel,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.14, 44),
		Size = UDim2.fromOffset(700, 22),
		TextSize = 16,
		TextColor3 = C.muted,
		Text = "Escolha uma carta — o jogo continua rolando!",
	})
	local cardsRow = new("Frame", {
		Parent = levelPanel,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.fromOffset(760, 330),
		BackgroundTransparency = 1,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 20),
		}),
	})

	local function makeCard(index, card)
		local button = new("TextButton", {
			Parent = cardsRow,
			LayoutOrder = index,
			Size = UDim2.fromOffset(230, 320),
			BackgroundColor3 = C.panel,
			AutoButtonColor = true,
			Text = "",
		}, { corner(10), stroke(card.color, 2.5) })
		new("Frame", { Parent = button, Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = card.color, BorderSizePixel = 0 }, { corner(10) })
		text({
			Parent = button,
			Position = UDim2.fromOffset(0, 22),
			Size = UDim2.new(1, 0, 0, 18),
			TextSize = 13,
			TextColor3 = card.kind == "ultimate" and C.gold or card.color,
			Text = KIND_BADGE[card.kind] or "",
		})
		text({
			Parent = button,
			Position = UDim2.fromOffset(12, 48),
			Size = UDim2.new(1, -24, 0, 56),
			Font = FONT_TITLE,
			TextSize = 22,
			TextWrapped = true,
			Text = card.title,
		})
		text({
			Parent = button,
			Position = UDim2.fromOffset(12, 110),
			Size = UDim2.new(1, -24, 0, 22),
			TextSize = 16,
			TextColor3 = card.color,
			TextWrapped = true,
			Text = card.ability,
		})
		text({
			Parent = button,
			Position = UDim2.fromOffset(16, 142),
			Size = UDim2.new(1, -32, 0, 100),
			TextSize = 14,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = C.muted,
			Text = card.desc,
		})
		local footer = ""
		if card.kind == "ultimate" then
			footer = string.format("Manual · recarga %ds", card.cd)
		elseif card.cd then
			footer = string.format("Automática · recarga %ds", card.cd)
		end
		text({
			Parent = button,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 12, 1, -40),
			Size = UDim2.new(1, -24, 0, 18),
			TextSize = 12,
			TextColor3 = C.muted,
			Text = footer,
		})
		if card.tier > 0 then
			for i = 1, 4 do
				new("Frame", {
					Parent = button,
					AnchorPoint = Vector2.new(0.5, 1),
					Position = UDim2.new(0.5, (i - 2.5) * 34, 1, -16),
					Size = UDim2.fromOffset(28, 8),
					BackgroundColor3 = i <= card.tier and (i == 4 and C.gold or card.color) or C.dark,
					BorderSizePixel = 0,
				}, { corner(2) })
			end
		end
		return button
	end

	local function showOffer(cards, level)
		for _, child in cardsRow:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		if not cards then
			levelPanel.Visible = false
			return
		end
		levelTitle.Text = level == 1 and "ESCOLHA SEU PRIMEIRO PODER" or ("NÍVEL " .. tostring(level) .. "!")
		local chosen = false
		for i, card in cards do
			local button = makeCard(i, card)
			button.MouseButton1Click:Connect(function()
				if chosen then
					return
				end
				chosen = true
				levelPanel.Visible = false
				Net.ChooseCard:FireServer(i)
			end)
		end
		levelPanel.Visible = true
		cardsRow.Position = UDim2.fromScale(0.5, 0.62)
		TweenService:Create(cardsRow, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.fromScale(0.5, 0.55) }):Play()
	end

	-- avisos --------------------------------------------------------------------------
	local toastTitle = text({
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.2, 0),
		Size = UDim2.fromOffset(800, 40),
		Font = FONT_TITLE,
		TextSize = 32,
		TextColor3 = C.gold,
		TextStrokeTransparency = 0.3,
		TextTransparency = 1,
		ZIndex = 20,
	})
	local toastSub = text({
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.2, 42),
		Size = UDim2.fromOffset(800, 24),
		TextSize = 17,
		TextStrokeTransparency = 0.4,
		TextTransparency = 1,
		ZIndex = 20,
	})
	local toastToken = 0
	local function notify(title, subtitle)
		toastToken += 1
		local token = toastToken
		toastTitle.Text = title or ""
		toastSub.Text = subtitle or ""
		toastTitle.TextTransparency = 0
		toastSub.TextTransparency = 0
		task.delay(2.8, function()
			if toastToken == token then
				local info = TweenInfo.new(0.6)
				TweenService:Create(toastTitle, info, { TextTransparency = 1 }):Play()
				TweenService:Create(toastSub, info, { TextTransparency = 1 }):Play()
			end
		end)
	end

	-- eventos do servidor -------------------------------------------------------------
	local runState = { inRun = false }

	Net.RunState.OnClientEvent:Connect(function(state)
		runState = state
		runFrame.Visible = state.inRun
		lobbyHint.Visible = not state.inRun
		if not state.inRun then
			levelPanel.Visible = false
			return
		end
		dungeonLabel.Text = string.upper(state.dungeon)
		if state.wave > state.waves then
			waveLabel.Text = "CHEFE"
		elseif state.wave == 0 then
			waveLabel.Text = "Preparando..."
		else
			waveLabel.Text = string.format("Onda %d/%d", state.wave, state.waves)
		end
		if state.boss then
			bossBar.back.Visible = true
			setBar(bossBar, state.boss.hp / state.boss.max)
			bossBar.label.Text = string.format("%s  ·  %d/%d", state.boss.name, math.ceil(state.boss.hp), math.floor(state.boss.max))
		else
			bossBar.back.Visible = false
		end
		timeLabel.Text = "Tempo  " .. formatTime(state.time)
		killsLabel.Text = "Abates  " .. state.kills
		goldLabel.Text = "Ouro  " .. state.gold
		enemiesLabel.Text = "Inimigos  " .. state.enemies
		levelLabel.Text = "NV " .. state.level
		setBar(xpBar, state.xp / state.xpNeed)
		xpBar.label.Text = string.format("%d / %d XP", state.xp, state.xpNeed)
		for i = 1, 4 do
			updateSlot(slots[i], state.slots[i])
		end
	end)

	Net.LevelUpOffer.OnClientEvent:Connect(showOffer)
	Net.Notify.OnClientEvent:Connect(notify)

	Net.Profile.OnClientEvent:Connect(function(data)
		profileLevel.Text = "CONTA NV " .. data.level
		profileGold.Text = data.gold .. " ouro"
		setBar(accountBar, data.xp / data.xpNeed)
		profileProgress.Text = string.format("Masmorras concluídas: %d/%d", data.cleared, data.totalDungeons)
	end)
	Net.Profile:FireServer() -- pede o perfil agora que o HUD está pronto

	-- vida e escudo (lidos direto do personagem) --------------------------------------
	local lastHealth = nil
	RunService.RenderStepped:Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			lastHealth = nil
			return
		end
		local maxHealth = math.max(1, humanoid.MaxHealth)
		setBar(hpBar, humanoid.Health / maxHealth)
		local shield = math.floor(runState.inRun and runState.shield or 0)
		shieldFill.Size = UDim2.fromScale(math.clamp(shield / maxHealth, 0, 1), 1)
		hpBar.label.Text = string.format("%d / %d%s", math.ceil(humanoid.Health), math.floor(maxHealth), shield > 0 and string.format("  (+%d escudo)", shield) or "")

		if lastHealth and humanoid.Health < lastHealth - 0.5 then
			hurtFlash.BackgroundTransparency = 0.75
			TweenService:Create(hurtFlash, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
		end
		lastHealth = humanoid.Health
	end)
end

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">VFX</string>
              <string name="Source"><![CDATA[--[[
	Desenha todos os efeitos visuais no cliente.

	- Efeitos instantâneos chegam pelo remote "Fx" (explosão, golpe do céu, raio, morte...).
	- Objetos que duram (projéteis, lâminas, zonas, orbes) são Parts do servidor em workspace.FX
	  com o atributo "Fx"; aqui eles ganham rastro, brilho, partículas e forma (espada, lança...).

	Quer trocar um efeito por um pack baixado (Toolbox/Creator Store)?
	Coloque o modelo em ReplicatedStorage.Assets.VFX com um destes nomes:
	  Explosion, Hit, Death, Spawn, LevelUp, Strike_sword, Strike_meteor, Strike_lightning,
	  Strike_orbital, Strike_void, Strike_pillar
	Todo ParticleEmitter dentro dele é disparado (atributo EmitCount = quantidade, padrão 25),
	escalado pelo raio do efeito. Os efeitos padrão abaixo continuam sendo usados se não houver modelo.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local player = Players.LocalPlayer

local VFX = {}

-- texturas que já vêm com o Roblox (não precisam de upload)
local TEX = {
	spark = "rbxasset://textures/particles/sparkles_main.dds",
	fire = "rbxasset://textures/particles/fire_main.dds",
	fireSpark = "rbxasset://textures/particles/fire_sparks_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	core = "rbxasset://textures/particles/explosion01_core_main.dds",
	shock = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	implode = "rbxasset://textures/particles/explosion01_implosion_main.dds",
	glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
	vortex = "rbxasset://textures/particles/forcefield_vortex_main.dds",
}
local SOUND = {
	slash = "rbxasset://sounds/swordslash.wav",
	lunge = "rbxasset://sounds/swordlunge.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
}
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 210, 90)

local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientFX"
fxFolder.Parent = workspace

-- utilidades ----------------------------------------------------------------------

local function tween(instance, time, props, style, direction)
	local t = TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function neon(shape, size, cframe, color, transparency)
	local part = Instance.new("Part")
	part.Shape = shape
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.Neon
	part.Transparency = transparency or 0
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = fxFolder
	return part
end

local function holder(cframe, size)
	local part = neon(Enum.PartType.Block, size or Vector3.one, cframe, WHITE, 1)
	return part
end

local function particles(parent, props)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Texture = TEX.spark
	for key, value in props do
		emitter[key] = value
	end
	emitter.Parent = parent
	return emitter
end

local function pointLight(parent, color, range, brightness, time)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = math.min(range, 60)
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = parent
	if time then
		tween(light, time, { Brightness = 0 })
	end
	return light
end

local function trail(part, offsetA, offsetB, color, lifetime)
	local a0 = Instance.new("Attachment")
	a0.Position = offsetA
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = offsetB
	a1.Parent = part
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Color = ColorSequence.new(WHITE, color)
	t.Transparency = NumberSequence.new(0.1, 1)
	t.WidthScale = NumberSequence.new(1, 0.2)
	t.Lifetime = lifetime or 0.25
	t.LightEmission = 1
	t.LightInfluence = 0
	t.Parent = part
	return t
end

local function playSound(id, position, volume, speed)
	local h = holder(CFrame.new(position))
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = (speed or 1) * (0.9 + math.random() * 0.2)
	sound.RollOffMaxDistance = 120
	sound.Parent = h
	sound:Play()
	Debris:AddItem(h, 2)
end
VFX.PlaySound = playSound
VFX.Sounds = SOUND

-- modelo de efeito baixado (ReplicatedStorage.Assets.VFX)
local function playTemplate(name, position, radius)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("VFX")
	local template = folder and folder:FindFirstChild(name)
	if not template then
		return false
	end
	local clone = template:Clone()
	if clone:IsA("Model") then
		clone:PivotTo(CFrame.new(position))
	elseif clone:IsA("BasePart") then
		clone.CFrame = CFrame.new(position)
	end
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanQuery = false
		end
	end
	clone.Parent = fxFolder
	local scale = math.max(0.3, (radius or 5) / 5)
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("ParticleEmitter") then
			if scale ~= 1 then
				local points = {}
				for _, point in descendant.Size.Keypoints do
					table.insert(points, NumberSequenceKeypoint.new(point.Time, point.Value * scale, point.Envelope * scale))
				end
				descendant.Size = NumberSequence.new(points)
			end
			descendant:Emit(descendant:GetAttribute("EmitCount") or 25)
		end
	end
	Debris:AddItem(clone, 4)
	return true
end

-- tremor de câmera -------------------------------------------------------------------

local trauma = 0

function VFX.Shake(intensity)
	trauma = math.min(1, trauma + intensity)
end

local function shakeNear(pos, intensity, radius)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local dist = (root.Position - pos).Magnitude
	if dist < radius then
		VFX.Shake(intensity * (1 - dist / radius))
	end
end

RunService.RenderStepped:Connect(function(dt)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if trauma > 0 then
		local power = trauma * trauma * 1.4
		humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * power, (math.random() - 0.5) * power, (math.random() - 0.5) * power)
		trauma = math.max(0, trauma - dt * 2.2)
	elseif humanoid.CameraOffset ~= Vector3.zero then
		humanoid.CameraOffset = Vector3.zero
	end
end)

-- peças básicas de efeito -------------------------------------------------------------

local function groundRing(pos, radius, color, time, texture)
	local h = holder(CFrame.new(pos + Vector3.new(0, 0.15, 0)), Vector3.new(radius * 0.3, 0.05, radius * 0.3))
	local decal = Instance.new("Decal")
	decal.Face = Enum.NormalId.Top
	decal.Texture = texture or TEX.shock
	decal.Color3 = color
	decal.Parent = h
	tween(h, time, { Size = Vector3.new(radius * 2.6, 0.05, radius * 2.6) })
	tween(decal, time, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(h, time + 0.05)
end

function VFX.Burst(pos, radius, color, time)
	time = time or 0.35
	if playTemplate("Explosion", pos, radius) then
		return
	end
	local shell = neon(Enum.PartType.Ball, Vector3.one * radius * 0.4, CFrame.new(pos), color, 0.15)
	tween(shell, time, { Size = Vector3.one * radius * 2.2, Transparency = 1 })
	Debris:AddItem(shell, time + 0.05)
	local core = neon(Enum.PartType.Ball, Vector3.one * radius * 0.5, CFrame.new(pos), WHITE, 0)
	tween(core, time * 0.5, { Size = Vector3.one * radius * 1.1, Transparency = 1 })
	Debris:AddItem(core, time)

	local h = holder(CFrame.new(pos), Vector3.one * math.max(1, radius * 0.4))
	particles(h, {
		Texture = TEX.fireSpark,
		Color = ColorSequence.new(WHITE, color),
		Size = NumberSequence.new(math.min(3, radius * 0.12 + 0.4), 0),
		Lifetime = NumberRange.new(0.3, 0.7),
		Speed = NumberRange.new(radius * 2, radius * 5),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 4,
		Acceleration = Vector3.new(0, -25, 0),
	}):Emit(math.clamp(math.floor(radius * 3), 8, 40))
	particles(h, {
		Texture = TEX.smoke,
		LightEmission = 0.15,
		Color = ColorSequence.new(color:Lerp(Color3.new(0, 0, 0), 0.5)),
		Size = NumberSequence.new(radius * 0.5, radius * 1.1),
		Transparency = NumberSequence.new(0.45, 1),
		Lifetime = NumberRange.new(0.6, 1),
		Speed = NumberRange.new(radius * 0.8, radius * 1.6),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-60, 60),
	}):Emit(math.clamp(math.floor(radius / 2), 3, 10))
	particles(h, {
		Texture = TEX.core,
		Color = ColorSequence.new(color),
		Size = NumberSequence.new(radius * 1.4, radius * 2.2),
		Transparency = NumberSequence.new(0, 1),
		Lifetime = NumberRange.new(0.25),
		Speed = NumberRange.new(0),
	}):Emit(1)
	pointLight(h, color, radius * 3, 5, 0.45)
	Debris:AddItem(h, 1.2)
end

function VFX.Ring(pos, radius, color, time)
	groundRing(pos, radius, color, time or 0.45)
end

function VFX.Telegraph(pos, radius, delay, color)
	local cf = CFrame.new(pos + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local outer = neon(Enum.PartType.Cylinder, Vector3.new(0.12, radius * 2, radius * 2), cf, color, 0.8)
	local inner = neon(Enum.PartType.Cylinder, Vector3.new(0.16, 0.4, 0.4), cf, color, 0.4)
	tween(inner, delay, { Size = Vector3.new(0.16, radius * 2, radius * 2) }, Enum.EasingStyle.Linear)
	local h = holder(CFrame.new(pos + Vector3.new(0, 0.2, 0)), Vector3.new(radius * 2, 0.05, radius * 2))
	local decal = Instance.new("Decal")
	decal.Face = Enum.NormalId.Top
	decal.Texture = TEX.shock
	decal.Color3 = color
	decal.Transparency = 0.3
	decal.Parent = h
	Debris:AddItem(outer, delay)
	Debris:AddItem(inner, delay)
	Debris:AddItem(h, delay)
end

-- espada fantasma: ponta na origem, lâmina subindo no +Y do `cframe`
local function buildGhostSword(cframe, length, width, color, transparency, anchored)
	local parts = {}
	local function add(size, offset, partColor, shape)
		local part = neon(shape or Enum.PartType.Block, size, cframe * offset, partColor, transparency)
		part.Anchored = anchored
		table.insert(parts, part)
		return part
	end
	local blade = length * 0.72
	add(Vector3.new(width, blade, width * 0.2), CFrame.new(0, width * 0.35 + blade / 2, 0), color)
	add(Vector3.new(width * 0.25, blade * 0.92, width * 0.26), CFrame.new(0, width * 0.35 + blade / 2, 0), WHITE)
	add(Vector3.new(width * 0.71, width * 0.71, width * 0.2), CFrame.new(0, width * 0.35, 0) * CFrame.Angles(0, 0, math.rad(45)), color)
	add(Vector3.new(width * 3.2, width * 0.45, width * 0.5), CFrame.new(0, width * 0.35 + blade, 0), color:Lerp(WHITE, 0.4))
	add(Vector3.new(width * 0.45, length * 0.2, width * 0.45), CFrame.new(0, width * 0.35 + blade + length * 0.1 + width * 0.2, 0), color:Lerp(Color3.new(0, 0, 0), 0.3))
	add(Vector3.one * width * 0.8, CFrame.new(0, width * 0.35 + blade + length * 0.22, 0), color:Lerp(WHITE, 0.4), Enum.PartType.Ball)
	return parts
end

local function moveParts(parts, from, to)
	local offset = to * from:Inverse()
	for _, part in parts do
		part.CFrame = offset * part.CFrame
	end
end

local function fadeParts(parts, time)
	for _, part in parts do
		tween(part, time, { Transparency = 1 })
		Debris:AddItem(part, time + 0.05)
	end
end

-- animação por frame com alpha 0..1
local function animate(duration, step, done)
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local alpha = math.min(1, (os.clock() - start) / duration)
		step(alpha)
		if alpha >= 1 then
			connection:Disconnect()
			if done then
				done()
			end
		end
	end)
end

-- golpes que caem do céu -------------------------------------------------------------

local StrikeVisuals = {}

function StrikeVisuals.sword(pos, radius, delay, color)
	local length = math.clamp(radius * 1.8, 6, 40)
	local width = length * 0.12
	local high = CFrame.new(pos + Vector3.new(0, 70, 0))
	local parts = buildGhostSword(high, length, width, color, 0.15, true)
	local current = high
	animate(delay, function(alpha)
		local y = 70 * (1 - alpha * alpha) - length * 0.2 * alpha
		local target = CFrame.new(pos + Vector3.new(0, y, 0)) * CFrame.Angles(0, alpha * math.pi * 0.5, 0)
		moveParts(parts, current, target)
		current = target
	end, function()
		task.delay(0.35, function()
			fadeParts(parts, 0.3)
		end)
	end)
end

function StrikeVisuals.meteor(pos, radius, delay, color)
	local start = pos + Vector3.new(-30, 80, 25)
	local size = math.clamp(radius * 0.55, 1.5, 18)
	local ball = neon(Enum.PartType.Ball, Vector3.one * size, CFrame.new(start), color, 0)
	local fire = particles(ball, {
		Texture = TEX.fire,
		Enabled = true,
		Rate = 70,
		Color = ColorSequence.new(WHITE, color),
		Size = NumberSequence.new(size * 0.9, 0),
		Lifetime = NumberRange.new(0.25, 0.5),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(25, 25),
		EmissionDirection = Enum.NormalId.Top,
	})
	trail(ball, Vector3.new(size * 0.4, 0, 0), Vector3.new(-size * 0.4, 0, 0), color, 0.35)
	pointLight(ball, color, size * 4, 3)
	animate(delay, function(alpha)
		ball.CFrame = CFrame.new(start:Lerp(pos, alpha * alpha))
	end, function()
		fire.Enabled = false
		ball.Transparency = 1
		Debris:AddItem(ball, 0.6)
	end)
end

local function lightning(from, to, color, thickness)
	local segments = 8
	local last = from
	local parts = {}
	for i = 1, segments do
		local point = from:Lerp(to, i / segments)
		if i < segments then
			point += Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * (from - to).Magnitude * 0.08
		end
		local dist = (point - last).Magnitude
		if dist > 0.05 then
			local cf = CFrame.lookAt((last + point) / 2, point)
			table.insert(parts, neon(Enum.PartType.Block, Vector3.new(thickness, thickness, dist), cf, color, 0))
			table.insert(parts, neon(Enum.PartType.Block, Vector3.new(thickness * 0.4, thickness * 0.4, dist), cf, WHITE, 0))
		end
		last = point
	end
	local h = holder(CFrame.new(to))
	pointLight(h, color, 50, 8, 0.3)
	Debris:AddItem(h, 0.4)
	-- piscada
	task.delay(0.06, function()
		for _, part in parts do
			part.Transparency = 0.7
		end
		task.wait(0.04)
		for _, part in parts do
			part.Transparency = 0
		end
		fadeParts(parts, 0.2)
	end)
end
VFX.Lightning = lightning

function StrikeVisuals.lightning(pos, radius, delay, color)
	task.delay(math.max(0, delay - 0.05), function()
		lightning(pos + Vector3.new(0, 80, 0), pos, color, math.clamp(radius * 0.08, 0.3, 1.5))
	end)
end

local function pillar(pos, radius, color, width)
	local column = neon(Enum.PartType.Cylinder, Vector3.new(80, width, width), CFrame.new(pos + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, 0.1)
	tween(column, 0.35, { Size = Vector3.new(80, 0.1, 0.1), Transparency = 1 })
	Debris:AddItem(column, 0.4)
	local inner = neon(Enum.PartType.Cylinder, Vector3.new(80, width * 0.4, width * 0.4), column.CFrame, WHITE, 0)
	tween(inner, 0.25, { Size = Vector3.new(80, 0.1, 0.1), Transparency = 1 })
	Debris:AddItem(inner, 0.3)
end

function StrikeVisuals.pillar(pos, radius, delay, color)
	task.delay(math.max(0, delay - 0.08), function()
		pillar(pos, radius, color, math.max(1.5, radius * 0.4))
	end)
end

function StrikeVisuals.orbital(pos, radius, delay, color)
	local guide = neon(Enum.PartType.Cylinder, Vector3.new(80, 0.4, 0.4), CFrame.new(pos + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, 0.4)
	Debris:AddItem(guide, delay)
	task.delay(math.max(0, delay - 0.05), function()
		pillar(pos, radius, color, radius * 1.4)
	end)
end

function StrikeVisuals.void(pos, radius, delay, color)
	local h = holder(CFrame.new(pos + Vector3.new(0, 2, 0)), Vector3.one * radius)
	local implode = particles(h, {
		Texture = TEX.implode,
		Enabled = true,
		Rate = 20,
		Color = ColorSequence.new(color),
		Size = NumberSequence.new(radius * 1.5, 0),
		Transparency = NumberSequence.new(0.3, 1),
		Lifetime = NumberRange.new(0.4),
		Speed = NumberRange.new(0),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-180, 180),
	})
	local orb = neon(Enum.PartType.Ball, Vector3.one * radius * 0.2, CFrame.new(pos + Vector3.new(0, 2, 0)), Color3.new(0.05, 0, 0.1), 0)
	tween(orb, delay, { Size = Vector3.one * radius * 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(orb, delay)
	task.delay(delay, function()
		implode.Enabled = false
		Debris:AddItem(h, 0.5)
	end)
end

function VFX.Strike(data)
	local pos, radius, delay, color, visual = data.pos, data.radius, data.delay, data.color, data.visual
	VFX.Telegraph(pos, radius, delay, color)
	if not playTemplate("Strike_" .. visual, pos, radius) then
		local draw = StrikeVisuals[visual] or StrikeVisuals.pillar
		draw(pos, radius, delay, color)
	end
	task.delay(delay, function()
		VFX.Burst(pos + Vector3.new(0, radius * 0.25, 0), radius, color)
		groundRing(pos, radius, color, 0.5)
	end)
end

-- impactos, morte, nascimento ---------------------------------------------------------

function VFX.HitSpark(pos, color)
	if playTemplate("Hit", pos, 2) then
		return
	end
	local h = holder(CFrame.new(pos))
	particles(h, {
		Color = ColorSequence.new(WHITE, color),
		Size = NumberSequence.new(0.6, 0),
		Lifetime = NumberRange.new(0.15, 0.3),
		Speed = NumberRange.new(15, 30),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 6,
	}):Emit(6)
	Debris:AddItem(h, 0.5)
end

-- contador de combo (abates seguidos do jogador local)
local comboLabel
local comboCount, comboToken = 0, 0
local function bumpCombo()
	if not comboLabel then
		local gui = Instance.new("ScreenGui")
		gui.Name = "Combo"
		gui.ResetOnSpawn = false
		gui.Parent = player:WaitForChild("PlayerGui")
		comboLabel = Instance.new("TextLabel")
		comboLabel.AnchorPoint = Vector2.new(1, 0.5)
		comboLabel.Position = UDim2.new(1, -30, 0.45, 0)
		comboLabel.Size = UDim2.fromOffset(260, 60)
		comboLabel.BackgroundTransparency = 1
		comboLabel.Font = Enum.Font.GothamBlack
		comboLabel.TextSize = 44
		comboLabel.TextXAlignment = Enum.TextXAlignment.Right
		comboLabel.TextColor3 = GOLD
		comboLabel.TextStrokeTransparency = 0.2
		comboLabel.TextTransparency = 1
		comboLabel.TextStrokeTransparency = 1
		comboLabel.Parent = gui
	end
	comboCount += 1
	comboToken += 1
	local token = comboToken
	comboLabel.Text = comboCount .. "x ABATES"
	comboLabel.TextTransparency = 0
	comboLabel.TextStrokeTransparency = 0.2
	comboLabel.TextSize = 54
	comboLabel.TextColor3 = comboCount >= 50 and Color3.fromRGB(255, 80, 80) or (comboCount >= 20 and Color3.fromRGB(255, 150, 60) or GOLD)
	tween(comboLabel, 0.15, { TextSize = 44 })
	task.delay(2.5, function()
		if token == comboToken then
			comboCount = 0
			tween(comboLabel, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

function VFX.Kill(data)
	local pos, size, color = data.pos, data.size, data.color
	if data.killer == player then
		bumpCombo()
	end
	if data.boss then
		VFX.Burst(pos, 30, color, 0.8)
		groundRing(pos - Vector3.new(0, 4, 0), 40, GOLD, 1)
		VFX.Shake(1)
		return
	end
	if playTemplate("Death", pos, size) then
		return
	end
	-- pedaços voando
	for _ = 1, 6 do
		local chunk = neon(Enum.PartType.Block, Vector3.one * (size * 0.3 + math.random() * 0.4), CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), color, 0)
		chunk.Material = Enum.Material.SmoothPlastic
		chunk.Anchored = false
		chunk.AssemblyLinearVelocity = Vector3.new(math.random(-20, 20), math.random(15, 30), math.random(-20, 20))
		chunk.AssemblyAngularVelocity = Vector3.new(math.random(-10, 10), math.random(-10, 10), math.random(-10, 10))
		tween(chunk, 0.9, { Size = Vector3.one * 0.05 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(chunk, 0.9)
	end
	local h = holder(CFrame.new(pos))
	particles(h, {
		Texture = TEX.smoke,
		LightEmission = 0.2,
		Color = ColorSequence.new(color:Lerp(WHITE, 0.3)),
		Size = NumberSequence.new(size * 1.2, size * 2.2),
		Transparency = NumberSequence.new(0.3, 1),
		Lifetime = NumberRange.new(0.4, 0.7),
		Speed = NumberRange.new(3, 8),
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
	}):Emit(5)
	particles(h, {
		Color = ColorSequence.new(WHITE, color),
		Size = NumberSequence.new(0.8, 0),
		Lifetime = NumberRange.new(0.3, 0.5),
		Speed = NumberRange.new(10, 25),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 5,
	}):Emit(12)
	Debris:AddItem(h, 1)
end

function VFX.Spawn(data)
	local pos, size, color = data.pos, data.size, data.color
	if playTemplate("Spawn", pos, size) then
		return
	end
	groundRing(pos, size * (data.boss and 4 or 1.6), color, data.boss and 1.2 or 0.6, TEX.vortex)
	local h = holder(CFrame.new(pos + Vector3.new(0, 1, 0)), Vector3.new(size, 0.2, size))
	particles(h, {
		Texture = TEX.spark,
		Color = ColorSequence.new(color),
		Size = NumberSequence.new(0.8, 0),
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(6, 14),
		SpreadAngle = Vector2.new(15, 15),
		EmissionDirection = Enum.NormalId.Top,
	}):Emit(data.boss and 60 or 12)
	Debris:AddItem(h, 1)
	if data.boss then
		VFX.Shake(0.8)
	end
end

function VFX.LevelUp(data)
	local character = data.player and data.player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	if playTemplate("LevelUp", root.Position, 6) then
		return
	end
	local ground = root.Position - Vector3.new(0, 2.9, 0)
	pillar(ground, 6, GOLD, 5)
	groundRing(ground, 8, GOLD, 0.6)
	local h = holder(CFrame.new(ground), Vector3.new(4, 0.2, 4))
	particles(h, {
		Color = ColorSequence.new(WHITE, GOLD),
		Size = NumberSequence.new(0.7, 0),
		Lifetime = NumberRange.new(0.6, 1.1),
		Speed = NumberRange.new(8, 16),
		SpreadAngle = Vector2.new(10, 10),
		EmissionDirection = Enum.NormalId.Top,
	}):Emit(40)
	Debris:AddItem(h, 1.5)
	if data.player == player then
		playSound(SOUND.ping, root.Position, 0.6, 1.2)
	end
end

function VFX.Beam(data)
	local from, to, width, color, time = data.from, data.to, data.width, data.color, data.time
	local dist = (to - from).Magnitude
	local cf = CFrame.lookAt((from + to) / 2, to)
	local outer = neon(Enum.PartType.Block, Vector3.new(width, width, dist), cf, color, 0.15)
	local inner = neon(Enum.PartType.Block, Vector3.new(width * 0.35, width * 0.35, dist), cf, WHITE, 0)
	tween(outer, time, { Size = Vector3.new(width * 0.1, width * 0.1, dist), Transparency = 1 })
	tween(inner, time, { Size = Vector3.new(0.05, 0.05, dist), Transparency = 1 })
	Debris:AddItem(outer, time + 0.05)
	Debris:AddItem(inner, time + 0.05)
	local h = holder(CFrame.new(to))
	pointLight(h, color, width * 6, 3, time)
	Debris:AddItem(h, time + 0.05)
end

-- decoração dos objetos do servidor (workspace.FX) ----------------------------------------

local function hide(part)
	part.LocalTransparencyModifier = 1
end

local function attachTo(base, part)
	part.Anchored = false
	part.Massless = true
	part.Parent = base
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
end

local Decorators = {}

function Decorators.orb(part)
	local size = part.Size.X
	trail(part, Vector3.new(size * 0.4, 0, 0), Vector3.new(-size * 0.4, 0, 0), part.Color, 0.2)
	pointLight(part, part.Color, size * 6, 2)
	particles(part, {
		Enabled = true,
		Rate = 25,
		Color = ColorSequence.new(WHITE, part.Color),
		Size = NumberSequence.new(size * 0.4, 0),
		Lifetime = NumberRange.new(0.2, 0.35),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(180, 180),
	})
end

function Decorators.blade(part)
	hide(part)
	local length = math.max(part.Size.Z, part.Size.X * 2.5)
	-- ponta para a frente (-Z), lâmina para trás
	local origin = part.CFrame * CFrame.new(0, 0, -length / 2) * CFrame.Angles(math.rad(90), 0, 0)
	for _, piece in buildGhostSword(origin, length, length * 0.13, part.Color, 0.1, false) do
		attachTo(part, piece)
	end
	trail(part, Vector3.new(0, 0, -length / 2), Vector3.new(0, 0, length * 0.2), part.Color, 0.18)
	pointLight(part, part.Color, 10, 1.5)
end

function Decorators.bullet(part)
	hide(part)
	local cf = part.CFrame
	local tracer = neon(Enum.PartType.Block, Vector3.new(0.25, 0.25, 2.4), cf, part.Color, 0)
	attachTo(part, tracer)
	local core = neon(Enum.PartType.Block, Vector3.new(0.1, 0.1, 2.6), cf, WHITE, 0)
	attachTo(part, core)
	trail(part, Vector3.new(0.12, 0, 0), Vector3.new(-0.12, 0, 0), part.Color, 0.1)
	pointLight(part, part.Color, 6, 1.5)
end

function Decorators.lance(part)
	hide(part)
	local cf = part.CFrame
	attachTo(part, neon(Enum.PartType.Block, Vector3.new(0.35, 0.35, 5.5), cf * CFrame.new(0, 0, 1), part.Color, 0.05))
	attachTo(part, neon(Enum.PartType.Block, Vector3.new(0.6, 0.6, 1.2), cf * CFrame.new(0, 0, -2) * CFrame.Angles(0, 0, math.rad(45)), WHITE, 0))
	trail(part, Vector3.new(0.3, 0, 0), Vector3.new(-0.3, 0, 0), part.Color, 0.25)
	pointLight(part, part.Color, 12, 2)
end

function Decorators.wind(part)
	hide(part)
	local size = math.max(part.Size.X, 2) * 2.5
	local crescent = neon(Enum.PartType.Block, Vector3.new(size, 0.3, size * 0.35), part.CFrame, part.Color, 0.35)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = crescent
	attachTo(part, crescent)
	trail(part, Vector3.new(size / 2, 0, 0), Vector3.new(-size / 2, 0, 0), part.Color, 0.2)
end

function Decorators.fireball(part)
	local size = part.Size.X
	particles(part, {
		Texture = TEX.fire,
		Enabled = true,
		Rate = 60,
		Color = ColorSequence.new(WHITE, part.Color),
		Size = NumberSequence.new(size * 1.2, 0),
		Lifetime = NumberRange.new(0.25, 0.45),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(20, 20),
		EmissionDirection = Enum.NormalId.Back,
	})
	trail(part, Vector3.new(size * 0.4, 0, 0), Vector3.new(-size * 0.4, 0, 0), part.Color, 0.3)
	pointLight(part, part.Color, size * 6, 3)
end

function Decorators.enemy(part)
	part.Color = Color3.fromRGB(255, 70, 50)
	local size = part.Size.X
	trail(part, Vector3.new(size * 0.4, 0, 0), Vector3.new(-size * 0.4, 0, 0), part.Color, 0.2)
	pointLight(part, part.Color, 10, 2)
end

function Decorators.xp(part)
	pointLight(part, part.Color, 6, 1)
	particles(part, {
		Enabled = true,
		Rate = 6,
		Color = ColorSequence.new(part.Color),
		Size = NumberSequence.new(0.4, 0),
		Lifetime = NumberRange.new(0.4, 0.6),
		Speed = NumberRange.new(0.5, 1.5),
		SpreadAngle = Vector2.new(180, 180),
	})
	trail(part, Vector3.new(0.3, 0, 0), Vector3.new(-0.3, 0, 0), part.Color, 0.15)
end

function Decorators.summon(part)
	hide(part)
	local cf = part.CFrame
	local color = part.Color
	attachTo(part, neon(Enum.PartType.Block, Vector3.new(1.6, 1.8, 0.9), cf, color, 0.3))
	attachTo(part, neon(Enum.PartType.Ball, Vector3.one * 1.2, cf * CFrame.new(0, 1.5, 0), color, 0.3))
	for _, side in { -1, 1 } do
		attachTo(part, neon(Enum.PartType.Block, Vector3.new(0.45, 1.6, 0.45), cf * CFrame.new(side * 1.1, -0.1, 0), color, 0.4))
		attachTo(part, neon(Enum.PartType.Block, Vector3.new(0.18, 0.18, 0.05), cf * CFrame.new(side * 0.25, 1.6, -0.6), WHITE, 0))
	end
	particles(part, {
		Texture = TEX.smoke,
		Enabled = true,
		Rate = 12,
		LightEmission = 0.4,
		Color = ColorSequence.new(color),
		Size = NumberSequence.new(1.5, 2.5),
		Transparency = NumberSequence.new(0.6, 1),
		Lifetime = NumberRange.new(0.5, 0.8),
		Speed = NumberRange.new(0.5, 1.5),
	})
	pointLight(part, color, 12, 1.5)
end

local function zoneParticles(part, vortex)
	-- o disco é um cilindro deitado: o raio está em Size.Y/Z
	local radius = part.Size.Y / 2
	part.Transparency = 0.82
	local area = Instance.new("Part")
	area.Size = Vector3.new(radius * 1.6, 0.2, radius * 1.6)
	area.CFrame = CFrame.new(part.Position)
	area.Transparency = 1
	area.CanCollide = false
	area.CanQuery = false
	area.CanTouch = false
	attachTo(part, area)
	particles(area, {
		Texture = vortex and TEX.glow or TEX.spark,
		Enabled = true,
		Rate = math.clamp(radius * 4, 10, 80),
		Shape = Enum.ParticleEmitterShape.Box,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
		EmissionDirection = Enum.NormalId.Top,
		Color = ColorSequence.new(WHITE, part.Color),
		Size = NumberSequence.new(vortex and 1.2 or 0.7, 0),
		Lifetime = NumberRange.new(0.5, 1),
		Speed = NumberRange.new(3, 8),
		RotSpeed = NumberRange.new(-200, 200),
		Acceleration = vortex and Vector3.new(0, 10, 0) or Vector3.new(0, 4, 0),
	})
	local decalHolder = Instance.new("Part")
	decalHolder.Size = Vector3.new(radius * 2, 0.05, radius * 2)
	decalHolder.CFrame = CFrame.new(part.Position + Vector3.new(0, 0.1, 0))
	decalHolder.Transparency = 1
	decalHolder.CanCollide = false
	decalHolder.CanQuery = false
	decalHolder.CanTouch = false
	attachTo(part, decalHolder)
	local decal = Instance.new("Decal")
	decal.Face = Enum.NormalId.Top
	decal.Texture = vortex and TEX.vortex or TEX.shock
	decal.Color3 = part.Color
	decal.Transparency = 0.25
	decal.Parent = decalHolder
	pointLight(part, part.Color, radius * 2, 1.5)
end

function Decorators.zone(part)
	zoneParticles(part, false)
end

function Decorators.vortex(part)
	zoneParticles(part, true)
end

function Decorators.shield(part)
	part.Material = Enum.Material.ForceField
	part.Transparency = 0
	pointLight(part, part.Color, 14, 1)
end

function Decorators.ice(part)
	part.Material = Enum.Material.Glass
	part.Transparency = 0.35
	part.Reflectance = 0.3
	local h = holder(part.CFrame, part.Size)
	particles(h, {
		Color = ColorSequence.new(WHITE),
		Size = NumberSequence.new(0.5, 0),
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(5, 12),
		SpreadAngle = Vector2.new(180, 180),
	}):Emit(15)
	Debris:AddItem(h, 1)
end

local function decorate(part)
	if not part:IsA("BasePart") then
		return
	end
	local kind = part:GetAttribute("Fx")
	local decorator = kind and Decorators[kind]
	if decorator then
		local ok, err = pcall(decorator, part)
		if not ok then
			warn("[VFX] " .. tostring(err))
		end
	end
end

-- entrada --------------------------------------------------------------------------------

local Handlers = {
	burst = function(d)
		VFX.Burst(d.pos, d.radius, d.color, d.time)
	end,
	ring = function(d)
		VFX.Ring(d.pos, d.radius, d.color, d.time)
	end,
	telegraph = function(d)
		VFX.Telegraph(d.pos, d.radius, d.delay, d.color)
	end,
	strike = VFX.Strike,
	beam = VFX.Beam,
	bolt = function(d)
		lightning(d.from, d.to, d.color, 0.35)
	end,
	kill = VFX.Kill,
	spawn = VFX.Spawn,
	levelup = VFX.LevelUp,
	shake = function(d)
		shakeNear(d.pos, d.intensity, d.radius)
	end,
}

function VFX.On(kind, handler)
	Handlers[kind] = handler
end

function VFX.Init()
	Net.Fx.OnClientEvent:Connect(function(kind, data)
		local handler = Handlers[kind]
		if handler then
			local ok, err = pcall(handler, data)
			if not ok then
				warn("[VFX] " .. kind .. ": " .. tostring(err))
			end
		end
	end)

	local serverFx = workspace:WaitForChild("FX")
	serverFx.ChildAdded:Connect(decorate)
	for _, child in serverFx:GetChildren() do
		decorate(child)
	end
end

return VFX
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="35">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>