		id = "thunder",
		name = "Trovão",
		color = Color3.fromRGB(255, 220, 60),
		tiers = {
			{ name = "Raios em Cadeia", desc = "Raio que pula entre 4 inimigos.", kind = "chain", cd = 6, damage = 40, jumps = 4, range = 20 },
			{ name = "Salto Elétrico", desc = "Raio que pula entre 8 inimigos.", kind = "chain", cd = 15, damage = 60, jumps = 8, range = 30 },
			{ name = "Pilar de Raios", desc = "Pilar de raios no alvo.", kind = "strike", visual = "lightning", cd = 20, damage = 150, radius = 8, delay = 0.3 },
			{ name = "Tempestade Divina", desc = "Raios caem por toda a arena.", kind = "strike", visual = "lightning", cd = 55, damage = 80, radius = 7, count = 40, interval = 0.1, delay = 0.3, area = 70 },
		},
	},
	{
		id = "darkness",
		name = "Escuridão",
		color = Color3.fromRGB(90, 40, 140),
		tiers = {
			{ name = "Nuvem Sombria", desc = "Nuvem de escuridão que fere.", kind = "zone", cd = 6, dps = 30, radius = 9, duration = 4 },
			{ name = "Cegueira", desc = "Inimigos ficam muito lentos.", kind = "nova", cd = 14, damage = 15, radius = 14, slow = 0.3, slowTime = 5, atTarget = true },
			{ name = "Devorar Almas", desc = "Dano em área que rouba vida.", kind = "nova", cd = 18, damage = 80, radius = 14, lifesteal = 0.3 },
			{ name = "Noite Eterna", desc = "Escuridão total ao seu redor.", kind = "zone", cd = 60, dps = 150, radius = 35, duration = 10, follow = true, slow = 0.5 },
		},
	},
	{
		id = "chaos_blades",
		name = "Lâminas do Caos",
		color = Color3.fromRGB(255, 60, 200),
		tiers = {
			{ name = "Órbita Caótica", desc = "3 lâminas orbitam você.", kind = "orbit", cd = 6, damage = 30, count = 3, radius = 7, duration = 6 },
			{ name = "Corte Telecinético", desc = "2 lâminas teleguiadas.", kind = "projectile", visual = "blade", cd = 15, damage = 70, count = 2, spread = 30, homing = true },
			{ name = "Espiral de Lâminas", desc = "12 lâminas em espiral.", kind = "projectile", visual = "blade", cd = 20, damage = 60, count = 12, spread = 360, pierce = 2 },
			{ name = "Dança do Caos", desc = "Centenas de lâminas giram ao seu redor.", kind = "orbit", cd = 55, damage = 80, count = 12, radius = 14, duration = 10, spin = 5 },
		},
	},
	{
		id = "elemental",
		name = "Domínio Elemental",
		color = Color3.fromRGB(255, 200, 80),
		colors = {
			Color3.fromRGB(255, 90, 40),
			Color3.fromRGB(90, 200, 255),
			Color3.fromRGB(90, 255, 120),
			Color3.fromRGB(255, 230, 80),
		},
		tiers = {
			{ name = "Fusão Elemental", desc = "3 projéteis elementais.", kind = "projectile", cd = 6, damage = 40, count = 3, spread = 30 },
			{ name = "Orbes Elementais", desc = "4 orbes orbitam você.", kind = "orbit", cd = 15, damage = 35, count = 4, radius = 10, duration = 8 },
			{ name = "Combo Elemental", desc = "3 explosões elementais.", kind = "strike", visual = "pillar", cd = 20, damage = 120, radius = 9, count = 3, interval = 0.3, area = 40 },
			{ name = "Cataclismo Elemental", desc = "Todos os elementos de uma vez.", kind = "strike", visual = "meteor", cd = 60, damage = 100, radius = 10, count = 25, interval = 0.1, area = 70 },
		},
	},
}

Powers.ById = {}
for _, power in Powers.List do
	Powers.ById[power.id] = power
end

return Powers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[-- Curvas de XP e cartas de atributo
local Progression = {}

-- XP para ir do nível `level` ao próximo DENTRO de uma run (reseta a cada masmorra)
function Progression.RunXpToNext(level)
	return math.floor(5 + level * 5 + level ^ 1.5)
end

-- XP de conta (persistente) para o próximo nível
function Progression.AccountXpToNext(level)
	return math.floor(100 * level ^ 1.35)
end

-- Cartas que aparecem misturadas com os poderes no level up
Progression.StatCards = {
	{ id = "vitality", name = "Vitalidade", desc = "+25 de vida máxima.", color = Color3.fromRGB(90, 220, 110) },
	{ id = "power", name = "Fúria", desc = "+12% de dano em tudo.", color = Color3.fromRGB(255, 110, 80) },
	{ id = "haste", name = "Foco", desc = "-10% de recarga das habilidades.", color = Color3.fromRGB(120, 170, 255) },
	{ id = "swift", name = "Agilidade", desc = "+2 de velocidade de movimento.", color = Color3.fromRGB(240, 240, 140) },
	{ id = "magnet", name = "Ímã", desc = "Coleta orbes de XP de mais longe.", color = Color3.fromRGB(90, 230, 255) },
}

Progression.StatCardsById = {}
for _, card in Progression.StatCards do
	Progression.StatCardsById[card.id] = card
end

return Progression
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Remotes compartilhados entre servidor e cliente.
-- O servidor cria; o cliente espera eles aparecerem.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local REMOTES = {
	"RunState", -- servidor -> cliente: estado da run para o HUD
	"LevelUpOffer", -- servidor -> cliente: cartas para escolher (nil fecha o painel)
	"ChooseCard", -- cliente -> servidor: índice da carta escolhida
	"CastUltimate", -- cliente -> servidor: slot da ultimate (1-4)
	"BasicAttack", -- cliente -> servidor: direção do ataque básico
	"DamageNumber", -- servidor -> cliente: número de dano flutuante
	"Notify", -- servidor -> cliente: aviso grande na tela
	"Profile", -- servidor <-> cliente: dados da conta (cliente pede ao iniciar)
	"Fx", -- servidor -> clientes: efeito visual para desenhar (tipo, dados)
}

local Net = {}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in REMOTES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, name in REMOTES do
	Net[name] = folder:WaitForChild(name)
end

return Net
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="14">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Ponto de entrada do servidor
local Services = script:WaitForChild("Services")

local WorldBuilder = require(Services.WorldBuilder)
local DataService = require(Services.DataService)
local DungeonService = require(Services.DungeonService)
local LobbyService = require(Services.LobbyService)
local WeaponService = require(Services.WeaponService)

WorldBuilder.SetupLighting()
WorldBuilder.BuildLobby()
DataService.Init()
WeaponService.Init()
DungeonService.Init()
LobbyService.Init()

print("[Portais do Abismo] servidor pronto")
]]></string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Dados persistentes da conta (DataStore).
-- No Studio: Game Settings > Security > "Enable Studio Access to API Services" para salvar de verdade.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Progression = require(ReplicatedStorage.Shared.Config.Progression)
local Dungeons = require(ReplicatedStorage.Shared.Config.Dungeons)
local Net = require(ReplicatedStorage.Shared.Net)

local DataService = {}

local STORE_NAME = "PortaisDoAbismo_v1"
local AUTOSAVE_INTERVAL = 120
local DEFAULT = {
	level = 1,
	xp = 0,
	gold = 0,
	cleared = 0, -- maior índice de masmorra concluída
}

local profiles = {}

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore indisponível, progresso não será salvo: " .. tostring(result))
	end
end

local function storeKey(player)
	return "player_" .. player.UserId
end

local function sync(player)
	local data = profiles[player]
	if not data then
		return
	end
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats["Nível"].Value = data.level
		stats.Ouro.Value = data.gold
	end
	Net.Profile:FireClient(player, {
		level = data.level,
		xp = data.xp,
		xpNeed = Progression.AccountXpToNext(data.level),
		gold = data.gold,
		cleared = data.cleared,
		totalDungeons = #Dungeons,
	})
end

local function load(player)
	local data = table.clone(DEFAULT)
	if store then
		local ok, saved = pcall(function()
			return store:GetAsync(storeKey(player))
		end)
		if ok and type(saved) == "table" then
			for key, value in saved do
				data[key] = value
			end
		elseif not ok then
			warn("[DataService] falha ao carregar " .. player.Name .. ": " .. tostring(saved))
		end
	end
	if not player.Parent then
		return -- saiu durante o carregamento
	end
	profiles[player] = data

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local level = Instance.new("IntValue")
	level.Name = "Nível"
	level.Parent = stats
	local gold = Instance.new("IntValue")
	gold.Name = "Ouro"
	gold.Parent = stats
	stats.Parent = player

	sync(player)
end

local function save(player)
	local data = profiles[player]
	if not data or not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(storeKey(player), data)
	end)
	if not ok then
		warn("[DataService] falha ao salvar " .. player.Name .. ": " .. tostring(err))
	end
end

function DataService.Init()
	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		-- deferido para outras partes (ex.: recompensas da run) rodarem antes de salvar
		task.defer(function()
			save(player)
			profiles[player] = nil
		end)
	end)

	game:BindToClose(function()
		for player in profiles do
			save(player)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(save, player)
			end
		end
	end)

	-- o cliente pede o perfil quando o HUD fica pronto
	Net.Profile.OnServerEvent:Connect(sync)
end

function DataService.Get(player)
	return profiles[player]
end

function DataService.GetCleared(player)
	local data = profiles[player]
	return data and data.cleared or 0
end

function DataService.AddGold(player, amount)
	local data = profiles[player]
	if not data then
		return
	end
	data.gold += amount
	sync(player)
end

function DataService.AddXp(player, amount)
	local data = profiles[player]
	if not data then
		return
	end
	data.xp += amount
	local need = Progression.AccountXpToNext(data.level)
	while data.xp >= need do
		data.xp -= need
		data.level += 1
		need = Progression.AccountXpToNext(data.level)
	end
	sync(player)
end

function DataService.MarkCleared(player, dungeonIndex)
	local data = profiles[player]
	if not data then
		return
	end
	data.cleared = math.max(data.cleared, dungeonIndex)
	sync(player)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">DungeonService</string>
            <string name="Source"><![CDATA[-- Runs de masmorra: arena, ondas, chefe, XP da run, level up com cartas e recompensas.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.Game)
local Dungeons = require(Shared.Config.Dungeons)
local Archetypes = require(Shared.Config.Enemies)
local Powers = require(Shared.Config.Powers)
local Progression = require(Shared.Config.Progression)
local Net = require(Shared.Net)

local Registry = require(script.Parent.Registry)
local Effects = require(script.Parent.Effects)
local EnemyService = require(script.Parent.EnemyService)
local PowerService = require(script.Parent.PowerService)
local WorldBuilder = require(script.Parent.WorldBuilder)
local DataService = require(script.Parent.DataService)

local DungeonService = {}

local Run = {}
Run.__index = Run

local usedSlots = {}
local nextRunId = 0

local XP_SMALL = Color3.fromRGB(90, 230, 255)
local XP_BIG = Color3.fromRGB(255, 200, 60)

-- utilidades -------------------------------------------------------------------

local function weightedPick(pool)
	local total = 0
	for _, option in pool do
		total += option.weight
	end
	local roll = math.random() * total
	for i, option in pool do
		roll -= option.weight
		if roll <= 0 then
			return table.remove(pool, i)
		end
	end
	return table.remove(pool)
end

local function waveWeights(wave)
	return {
		{ id = "chaser", weight = 5 },
		{ id = "runner", weight = wave >= 2 and 3 or 0 },
		{ id = "archer", weight = wave >= 3 and 2 or 0 },
		{ id = "brute", weight = wave >= 6 and 2 or (wave >= 4 and 1 or 0) },
	}
end

local function pickArchetype(wave)
	local pool = {}
	for _, option in waveWeights(wave) do
		if option.weight > 0 then
			table.insert(pool, option)
		end
	end
	return weightedPick(pool).id
end

-- descrição de uma carta para o cliente
local function describe(option)
	if option.type == "stat" then
		local card = Progression.StatCardsById[option.id]
		return { kind = "stat", title = card.name, ability = "Atributo", desc = card.desc, color = card.color, tier = 0 }
	end
	local power = Powers.ById[option.id]
	local t = power.tiers[option.tier]
	return {
		kind = option.tier == 4 and "ultimate" or option.type,
		title = power.name,
		ability = t.name,
		desc = t.desc,
		color = power.color,
		tier = option.tier,
		cd = t.cd,
	}
end

-- ciclo de vida da run -------------------------------------------------------------

function DungeonService.StartRun(dungeonIndex, players)
	local def = Dungeons[dungeonIndex]
	local slot = 1
	while usedSlots[slot] do
		slot += 1
	end
	usedSlots[slot] = true
	nextRunId += 1

	local arena = WorldBuilder.BuildArena(def, Vector3.new(GameConfig.ArenaSpacing * slot, 0, 0))
	local self = setmetatable({
		id = nextRunId,
		slot = slot,
		index = dungeonIndex,
		def = def,
		arena = arena,
		floorY = arena.floorY,
		players = {}, -- [Player] = estado
		enemies = {}, -- [enemy] = true
		orbs = {},
		wave = 0,
		bossEnemy = nil,
		kills = 0,
		gold = 0,
		startTime = os.clock(),
		lastState = 0,
		ended = false,
		connections = {},
	}, Run)

	self.enemyFolder = Instance.new("Folder")
	self.enemyFolder.Name = "Enemies"
	self.enemyFolder.Parent = arena.model

	for i, player in players do
		self:AddPlayer(player, i)
	end
	if not next(self.players) then
		self:End(false)
		return nil
	end

	table.insert(
		self.connections,
		RunService.Heartbeat:Connect(function(dt)
			self:Update(dt)
		end)
	)
	task.spawn(function()
		self:Loop()
	end)
	return self
end

function Run:AddPlayer(player, index)
	local root, humanoid = Registry.GetRoot(player)
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	local state = {
		player = player,
		run = self,
		active = true,
		level = 1,
		xp = 0,
		pending = 0,
		offer = nil,
		powers = {}, -- { {id, tier} } na ordem dos slots
		cooldowns = {},
		stats = { damageMult = 1, cooldownMult = 1, magnet = 14 },
		shield = 0,
		shieldUntil = 0,
		reflect = 0,
		reflectUntil = 0,
		invulnUntil = 0,
		buffMult = 1,
		buffUntil = 0,
		regen = 0,
		regenUntil = 0,
		lastBasic = 0,
		combo = 0,
		kills = 0,
	}
	self.players[player] = state
	Registry.ByPlayer[player] = state

	humanoid.MaxHealth = 100
	humanoid.Health = 100
	player.Character:PivotTo(CFrame.new(self.arena.playerSpawn + Vector3.new((index - 1) * 4 - 6, 3, 0)))
	state.diedConnection = humanoid.Died:Connect(function()
		self:PlayerDied(player)
	end)

	-- todo mundo começa escolhendo o primeiro poder
	state.pending = 1
	self:SendOffer(state)
end

function Run:Loop()
	self:NotifyAll(self.def.name, "Escolha seu primeiro poder e prepare-se!")
	task.wait(5)
	for wave = 1, self.def.waves do
		if self.ended then
			return
		end
		self.wave = wave
		self:NotifyAll("Onda " .. wave .. "/" .. self.def.waves, nil)
		self:SpawnWave(wave)
		while not self.ended and next(self.enemies) do
			task.wait(0.5)
		end
		if self.ended then
			return
		end
		task.wait(2)
	end
	self.wave = self.def.waves + 1
	self:NotifyAll(self.def.boss.name .. " apareceu!", "Derrote o chefe para concluir a masmorra")
	task.wait(1.5)
	if not self.ended then
		self:SpawnBoss()
	end
end

function Run:PlayerCount()
	local count = 0
	for _, state in self.players do
		if state.active then
			count += 1
		end
	end
	return count
end

function Run:EnemyCount()
	local count = 0
	for _ in self.enemies do
		count += 1
	end
	return count
end

-- inimigos ---------------------------------------------------------------------------

function Run:SpawnWave(wave)
	local players = math.max(1, self:PlayerCount())
	local total = math.floor((12 + wave * 7) * (1 + 0.5 * (players - 1)))
	local spawned = 0
	while spawned < total and not self.ended do
		while self:EnemyCount() >= GameConfig.MaxAliveEnemies and not self.ended do
			task.wait(0.5)
		end
		for _ = 1, math.min(GameConfig.SpawnGroupSize, total - spawned) do
			self:SpawnMob(pickArchetype(wave), wave)
			spawned += 1
		end
		task.wait(GameConfig.SpawnGroupInterval)
	end
end

function Run:MakeDef(archetypeId, wave)
	local base = Archetypes[archetypeId]
	local look = self.def.mobs[archetypeId]
	local players = math.max(1, self:PlayerCount())
	local scale = self.def.hpMult * (1 + 0.1 * (wave - 1)) * (1 + 0.35 * (players - 1))
	local def = table.clone(base)
	def.name = look.name
	def.model = look.model
	def.color = look.color
	def.eyeColor = self.def.theme.accent
	def.hp = math.floor(base.hp * scale)
	def.damage = base.damage * self.def.dmgMult
	return def
end

function Run:RandomSpawnPoint()
	local points = self.arena.spawnPoints
	for _ = 1, 8 do
		local point = points[math.random(#points)] + Vector3.new(math.random(-6, 6), 0, math.random(-6, 6))
		local clear = true
		for player in self.players do
			local root = Registry.GetRoot(player)
			if root and (root.Position - point).Magnitude < 25 then
				clear = false
				break
			end
		end
		if clear then
			return point
		end
	end
	return points[math.random(#points)]
end

function Run:SpawnMob(archetypeId, wave, position)
	if self.ended then
		return nil
	end
	return EnemyService.Spawn(self, self:MakeDef(archetypeId, wave), position or self:RandomSpawnPoint())
end

function Run:SpawnBoss()
	local boss = self.def.boss
	local players = math.max(1, self:PlayerCount())
	local def = table.clone(Archetypes.boss)
	def.name = boss.name
	def.model = boss.model
	def.color = boss.color
	def.size = boss.size
	def.skills = boss.skills
	def.eyeColor = self.def.theme.accent
	def.hp = math.floor(boss.hp * (1 + 0.6 * (players - 1)))
	def.damage = Archetypes.boss.damage * self.def.dmgMult
	def.boss = true
	self.bossEnemy = EnemyService.Spawn(self, def, self.arena.center + Vector3.new(0, 0, -50))
end

function Run:OnEnemyKilled(enemy)
	if self.ended then
		return
	end
	self.kills += 1
	self.gold += enemy.def.gold or 0
	local killer = enemy.lastHitBy
	if killer and self.players[killer] then
		self.players[killer].kills += 1
	end
	if enemy.def.boss then
		self:End(true)
		return
	end
	self:DropOrb(enemy.root.Position, enemy.def.xp or 1)
end

-- XP e level up ----------------------------------------------------------------------

function Run:DropOrb(pos, value)
	local big = value >= 5
	local orb = Effects.Part(Enum.PartType.Ball, Vector3.one * (big and 1.4 or 0.9), CFrame.new(pos.X, self.floorY + 1.2, pos.Z), big and XP_BIG or XP_SMALL, 0, "xp")
	orb.Parent = self.arena.model
	table.insert(self.orbs, { part = orb, value = value, target = nil })
end

-- XP é compartilhado: qualquer um que pegar um orbe dá XP para a party toda
function Run:GiveXp(amount)
	for player, state in self.players do
		if state.active then
			state.xp += amount
			local need = Progression.RunXpToNext(state.level)
			while state.xp >= need do
				state.xp -= need
				state.level += 1
				state.pending += 1
				need = Progression.RunXpToNext(state.level)
				state.invulnUntil = math.max(state.invulnUntil, os.clock() + 1)
				local _, humanoid = Registry.GetRoot(player)
				Effects.LevelUp(player)
				if humanoid then
					Registry.HealPlayer(player, humanoid.MaxHealth * 0.15)
				end
			end
			if state.pending > 0 and not state.offer then
				self:SendOffer(state)
			end
		end
	end
end

function Run:BuildOffer(state)
	local pool = {}
	local owned = {}
	for slot, power in state.powers do
		owned[power.id] = true
		if power.tier < 4 then
			table.insert(pool, { type = "upgrade", id = power.id, slot = slot, tier = power.tier + 1, weight = 3 })
		end
	end
	if #state.powers < GameConfig.MaxPowerSlots then
		local fresh = {}
		for _, power in Powers.List do
			if not owned[power.id] then
				table.insert(fresh, power.id)
			end
		end
		-- poderes novos dividem um peso total fixo, para upgrades não sumirem
		local weight = #state.powers == 0 and 1 or 4 / math.max(1, #fresh)
		for _, id in fresh do
			table.insert(pool, { type = "new", id = id, tier = 1, weight = weight })
		end
	end

	local options = {}
	while #options < 3 and #pool > 0 do
		table.insert(options, weightedPick(pool))
	end

	-- às vezes uma carta de atributo; sempre que faltar opção
	local stats = table.clone(Progression.StatCards)
	if #state.powers > 0 and #options == 3 and math.random() < 0.25 then
		table.remove(options)
	end
	while #options < 3 and #stats > 0 do
		local card = table.remove(stats, math.random(#stats))
		table.insert(options, { type = "stat", id = card.id })
	end
	return options
end

function Run:SendOffer(state)
	state.offer = self:BuildOffer(state)
	local cards = {}
	for i, option in state.offer do
		cards[i] = describe(option)
	end
	Net.LevelUpOffer:FireClient(state.player, cards, state.level)
end

function Run:ChooseCard(state, index)
	local offer = state.offer
	if not offer or type(index) ~= "number" then
		return
	end
	local option = offer[index]
	if not option then
		return
	end
	state.offer = nil
	state.pending -= 1
	local now = os.clock()

	if option.type == "new" then
		table.insert(state.powers, { id = option.id, tier = 1 })
		state.cooldowns[option.id .. 1] = now + 0.5
	elseif option.type == "upgrade" then
		local power = state.powers[option.slot]
		if power and power.id == option.id then
			power.tier = option.tier
			if power.tier <= 3 then
				state.cooldowns[power.id .. power.tier] = now + 0.5
			else
				local ultimate = Powers.ById[power.id].tiers[4]
				self:Notify(state.player, "ULTIMATE DESBLOQUEADA!", ultimate.name .. " — aperte " .. option.slot)
			end
		end
	else
		self:ApplyStat(state, option.id)
	end

	if state.pending > 0 then
		self:SendOffer(state)
	end
end

function Run:ApplyStat(state, id)
	local _, humanoid = Registry.GetRoot(state.player)
	if id == "vitality" then
		if humanoid then
			humanoid.MaxHealth += 25
			humanoid.Health += 25
		end
	elseif id == "power" then
		state.stats.damageMult += 0.12
	elseif id == "haste" then
		state.stats.cooldownMult *= 0.9
	elseif id == "swift" then
		if humanoid then
			humanoid.WalkSpeed += 2
		end
	elseif id == "magnet" then
		state.stats.magnet += 6
	end
end

-- loop por frame ------------------------------------------------------------------------

function Run:Update(dt)
	if self.ended then
		return
	end
	local now = os.clock()

	for player, state in self.players do
		if state.active then
			PowerService.Tick(state, now)
			if state.regen > 0 and now < state.regenUntil then
				Registry.HealPlayer(player, state.regen * dt)
			end
		end
	end
	if self.ended then
		return -- um poder pode ter matado o chefe
	end

	-- orbes de XP voam até quem chegar perto
	for i = #self.orbs, 1, -1 do
		local orb = self.orbs[i]
		local pos = orb.part.Position
		if not orb.target or not orb.target.Parent then
			orb.target = nil
			for player, state in self.players do
				local root = state.active and Registry.GetRoot(player)
				if root and (root.Position - pos).Magnitude <= state.stats.magnet then
					orb.target = root
					break
				end
			end
		end
		if orb.target then
			local toTarget = orb.target.Position - pos
			if toTarget.Magnitude < 2.5 then
				orb.part:Destroy()
				table.remove(self.orbs, i)
				self:GiveXp(orb.value)
			else
				orb.part.CFrame = CFrame.new(pos + toTarget.Unit * math.min(toTarget.Magnitude, 60 * dt))
			end
		end
	end

	if now - self.lastState >= 0.2 then
		self.lastState = now
		self:SendState()
	end
end

function Run:SendState()
	local now = os.clock()
	local boss = self.bossEnemy
	local bossInfo = nil
	if boss and not boss.dead then
		bossInfo = { name = boss.def.name, hp = boss.humanoid.Health, max = boss.humanoid.MaxHealth }
	end
	local enemyCount = self:EnemyCount()
	for player, state in self.players do
		local slots = {}
		for i, owned in state.powers do
			local power = Powers.ById[owned.id]
			slots[i] = {
				name = power.name,
				color = power.color,
				tier = owned.tier,
				ult = owned.tier >= 4 and power.tiers[4].name or nil,
				ultCd = math.max(0, (state.cooldowns[owned.id .. "ult"] or 0) - now),
				ultMax = power.tiers[4].cd,
			}
		end
		Net.RunState:FireClient(player, {
			inRun = true,
			dungeon = self.def.name,
			wave = self.wave,
			waves = self.def.waves,
			boss = bossInfo,
			level = state.level,
			xp = state.xp,
			xpNeed = Progression.RunXpToNext(state.level),
			shield = now < state.shieldUntil and state.shield or 0,
			kills = self.kills,
			gold = self.gold,
			time = now - self.startTime,
			enemies = enemyCount,
			slots = slots,
		})
	end
end

-- comunicação --------------------------------------------------------------------------

function Run:DamageNumber(pos, amount, color)
	for player in self.players do
		Net.DamageNumber:FireClient(player, pos, amount, color)
	end
end

function Run:Notify(player, title, subtitle)
	Net.Notify:FireClient(player, title, subtitle)
end

function Run:NotifyAll(title, subtitle)
	for player in self.players do
		self:Notify(player, title, subtitle)
	end
end

-- saída e fim ----------------------------------------------------------------------------

-- tira o jogador da run e entrega recompensas
function Run:Release(player, victory, leaving)
	local state = self.players[player]
	if not state then
		return
	end
	state.active = false
	if state.diedConnection then
		state.diedConnection:Disconnect()
	end
	self.players[player] = nil
	if Registry.ByPlayer[player] == state then
		Registry.ByPlayer[player] = nil
	end

	local gold = self.gold + (victory and self.def.reward.gold or 0)
	if not victory then
		gold = math.floor(gold * 0.5)
	end
	local xp = math.floor(self.kills * 1.5 + state.level * 5) + (victory and self.def.reward.xp or 0)
	DataService.AddGold(player, gold)
	DataService.AddXp(player, xp)
	if victory then
		DataService.MarkCleared(player, self.index)
	end

	if not leaving then
		Net.RunState:FireClient(player, { inRun = false })
		Net.LevelUpOffer:FireClient(player, nil)
		self:Notify(player, victory and "VITÓRIA!" or "Derrota...", string.format("+%d ouro  ·  +%d XP de conta", gold, xp))
	end
end

function Run:PlayerDied(player)
	local state = self.players[player]
	if not state or not state.active then
		return
	end
	self:Release(player, false)
	self:NotifyAll(player.DisplayName .. " caiu!", nil)
	if self:PlayerCount() == 0 then
		self:End(false)
	end
end

function Run:PlayerLeft(player)
	self:Release(player, false, true)
	if self:PlayerCount() == 0 then
		self:End(false)
	end
end

function Run:End(victory)
	if self.ended then
		return
	end
	self.ended = true
	for _, connection in self.connections do
		connection:Disconnect()
	end
	for enemy in self.enemies do
		EnemyService.Kill(enemy, true)
	end
	for _, orb in self.orbs do
		orb.part:Destroy()
	end
	self.orbs = {}

	local survivors = {}
	for player in self.players do
		table.insert(survivors, player)
	end
	for _, player in survivors do
		self:Release(player, victory)
	end

	if victory then
		for i = 1, 12 do
			task.delay(i * 0.25, function()
				local offset = Vector3.new(math.random(-40, 40), math.random(15, 35), math.random(-40, 40))
				Effects.Burst(self.arena.center + offset, math.random(5, 10), Color3.fromHSV(math.random(), 0.7, 1), 0.6)
			end)
		end
	end

	task.delay(victory and GameConfig.ReturnToLobbyDelay or 2, function()
		for _, player in survivors do
			if player.Parent then
				player:LoadCharacter() -- volta para o spawn do lobby
			end
		end
		self.arena.model:Destroy()
		usedSlots[self.slot] = nil
	end)
end

-- entrada ------------------------------------------------------------------------------------

function DungeonService.IsInRun(player)
	return Registry.ByPlayer[player] ~= nil
end

function DungeonService.Init()
	Net.ChooseCard.OnServerEvent:Connect(function(player, index)
		local state = Registry.ByPlayer[player]
		if state and state.active then
			state.run:ChooseCard(state, index)
		end
	end)

	Net.CastUltimate.OnServerEvent:Connect(function(player, slot)
		local state = Registry.ByPlayer[player]
		if not state or not state.active or type(slot) ~= "number" then
			return
		end
		local ok, name = PowerService.CastUltimate(state, slot)
		if ok then
			state.run:NotifyAll(player.DisplayName .. " usou " .. name .. "!", nil)
		end
	end)

	Net.BasicAttack.OnServerEvent:Connect(function(player, direction)
		local state = Registry.ByPlayer[player]
		if not state or not state.active or typeof(direction) ~= "Vector3" then
			return
		end
		if direction.X ~= direction.X or direction.Z ~= direction.Z then
			return -- NaN
		end
		PowerService.BasicAttack(state, direction)
	end)

	Players.PlayerRemoving:Connect(function(player)
		local state = Registry.ByPlayer[player]
		if state then
			state.run:PlayerLeft(player)
		end
	end)
end

return DungeonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Efeitos visuais.
-- Efeitos instantâneos (explosões, raios, golpes...) são só um aviso para os clientes:
-- quem desenha de verdade é o client/Controllers/VFX.luau (partículas, luz, tremor de câmera).
-- Objetos que duram (projéteis, lâminas orbitando, zonas, orbes) são Parts criadas aqui
-- com o atributo "Fx"; o cliente as "decora" com rastro, brilho e partículas.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local Effects = {}

local fxFolder = Instance.new("Folder")
fxFolder.Name = "FX"
fxFolder.Parent = workspace

-- deita o cilindro (o eixo do cilindro é X; isso o coloca em Y, como um disco no chão)
Effects.VERTICAL = CFrame.Angles(0, 0, math.rad(90))

local function send(kind, data)
	Net.Fx:FireAllClients(kind, data)
end
Effects.Send = send

-- Part persistente. `fx` diz ao cliente como decorá-la (ver VFX.luau).
function Effects.Part(shape, size, cframe, color, transparency, fx)
	local part = Instance.new("Part")
	part.Shape = shape
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.Neon
	part.Transparency = transparency or 0
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	if fx then
		part:SetAttribute("Fx", fx)
	end
	part.Parent = fxFolder
	return part
end

function Effects.Tween(instance, time, props, style)
	local tween = TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- explosão
function Effects.Burst(pos, radius, color, time)
	send("burst", { pos = pos, radius = radius, color = color, time = time or 0.35 })
end

-- onda de choque no chão
function Effects.Ring(groundPos, radius, color, time)
	send("ring", { pos = groundPos, radius = radius, color = color, time = time or 0.45 })
end

-- aviso no chão: o círculo enche até o golpe cair
function Effects.Telegraph(groundPos, radius, delay, color)
	send("telegraph", { pos = groundPos, radius = radius, delay = delay, color = color })
end

-- golpe que cai do céu (aviso + objeto caindo + explosão), tudo sincronizado com `delay`
-- visual: "pillar" (padrão), "sword", "meteor", "lightning", "orbital"
function Effects.Strike(groundPos, radius, delay, color, visual)
	send("strike", { pos = groundPos, radius = radius, delay = delay, color = color, visual = visual or "pillar" })
end

function Effects.Beam(from, to, width, color, time)
	if (to - from).Magnitude < 0.1 then
		return
	end
	send("beam", { from = from, to = to, width = width, color = color, time = time or 0.25 })
end

function Effects.Bolt(from, to, color)
	send("bolt", { from = from, to = to, color = color })
end

-- golpe de arma do jogador (o cliente anima o braço e desenha o rastro)
function Effects.Swing(player, combo, origin, direction, range, color)
	send("swing", { player = player, combo = combo, pos = origin, dir = direction, range = range, color = color })
end

function Effects.Kill(pos, size, color, killer, isBoss)
	send("kill", { pos = pos, size = size, color = color, killer = killer, boss = isBoss })
end

function Effects.LevelUp(player)
	send("levelup", { player = player })
end

-- tremor de câmera para quem estiver perto de `pos`
function Effects.Shake(pos, intensity, radius)
	send("shake", { pos = pos, intensity = intensity, radius = radius or 60 })
end

-- prende uma part de efeito no personagem (ela acompanha o movimento)
function Effects.Attach(part, root, offset)
	part.CFrame = root.CFrame * (offset or CFrame.identity)
	part.Anchored = false
	part.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
	return part
end

function Effects.Glow(model, color, duration)
	local highlight = Instance.new("Highlight")
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.FillTransparency = 0.6
	highlight.Parent = model
	Debris:AddItem(highlight, duration)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">EnemyService</string>
            <string name="Source"><![CDATA[-- Inimigos: criação do modelo, IA, dano, status (lento/congelado/empurrão) e habilidades de chefe.
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Effects = require(script.Parent.Effects)
local Projectiles = require(script.Parent.Projectiles)
local Registry = require(script.Parent.Registry)

local EnemyService = {}

local AI_STEP = 0.1
local DANGER = Color3.fromRGB(255, 50, 40)
local ENEMY_SHOT = Color3.fromRGB(255, 80, 60)
local ICE = Color3.fromRGB(170, 230, 255)
local REFLECT = Color3.fromRGB(90, 200, 255)

local active = {} -- [enemy] = true (todas as runs)

local function makePart(name, size, cframe, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function weld(a, b)
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = a
	constraint.Part1 = b
	constraint.Parent = a
end

local function visualPart(part)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Anchored = false
end

-- procura um modelo importado em ReplicatedStorage.Assets.Monsters
local function findMonsterAsset(name)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Monsters")
	return folder and name and folder:FindFirstChild(name)
end

-- Visual a partir de um modelo importado (Toolbox, Blender, 3D Importer...).
-- Ele é escalado para a altura do inimigo, posto no chão e preso ao root.
-- Se o monstro andar de costas, coloque no modelo o atributo Yaw = 180.
local function assetVisual(asset, root, def, model)
	local visual = asset:Clone()
	visual.Name = "Visual"
	for _, descendant in visual:GetDescendants() do
		if descendant:IsA("BasePart") then
			visualPart(descendant)
		elseif descendant:IsA("Humanoid") or descendant:IsA("BaseScript") or descendant:IsA("AnimationController") then
			descendant:Destroy()
		end
	end
	local primary = visual.PrimaryPart or visual:FindFirstChildWhichIsA("BasePart", true)
	if not primary then
		visual:Destroy()
		return nil
	end

	local yaw = math.rad(asset:GetAttribute("Yaw") or 0)
	visual:PivotTo(CFrame.new(visual:GetPivot().Position) * root.CFrame.Rotation * CFrame.Angles(0, yaw, 0))
	local _, extents = visual:GetBoundingBox()
	local targetHeight = def.size.Y * (asset:GetAttribute("HeightScale") or 1.35)
	if extents.Y > 0.01 then
		visual:ScaleTo(visual:GetScale() * targetHeight / extents.Y)
	end
	local box, size = visual:GetBoundingBox()
	local floorY = root.Position.Y - def.size.Y / 2 - 0.3
	visual:PivotTo(visual:GetPivot() + (Vector3.new(root.Position.X, floorY + size.Y / 2, root.Position.Z) - box.Position))

	for _, descendant in visual:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= primary then
			weld(primary, descendant)
		end
	end
	visual.Parent = model
	return primary
end

-- Visual padrão feito de blocos (corpo, cabeça, braços, olhos brilhando)
local function blockVisual(root, def, model)
	local size = def.size
	local rootCf = root.CFrame
	local body = makePart("Body", size, rootCf, def.color, nil, model)
	visualPart(body)

	local headSize = Vector3.new(size.X * 0.8, size.X * 0.7, size.Z * 0.9)
	local headCf = rootCf * CFrame.new(0, size.Y / 2 + headSize.Y / 2, 0)
	local head = makePart("Head", headSize, headCf, def.color:Lerp(Color3.new(1, 1, 1), 0.15), nil, model)
	visualPart(head)
	weld(body, head)

	for _, side in { -1, 1 } do
		local eyeCf = headCf * CFrame.new(side * headSize.X * 0.22, headSize.Y * 0.1, -headSize.Z / 2 - 0.05)
		local eye = makePart("Eye", Vector3.new(headSize.X * 0.18, headSize.Y * 0.18, 0.1), eyeCf, def.eyeColor or DANGER, Enum.Material.Neon, model)
		visualPart(eye)
		weld(head, eye)
		local armSize = Vector3.new(size.X * 0.28, size.Y * 0.7, size.Z * 0.5)
		local armCf = rootCf * CFrame.new(side * (size.X / 2 + armSize.X / 2), size.Y * 0.1, 0)
		local arm = makePart("Arm", armSize, armCf, def.color:Lerp(Color3.new(0, 0, 0), 0.15), nil, model)
		visualPart(arm)
		weld(body, arm)
	end
	return body
end

local function buildModel(def, position)
	local model = Instance.new("Model")
	model.Name = def.name

	-- o root é a "caixa de colisão" invisível; o visual fica preso a ele por um Motor6D
	-- chamado "Visual", que o cliente anima (balanço ao andar, investida, recuo ao levar dano)
	local size = def.size
	local rootCf = CFrame.new(position + Vector3.new(0, size.Y / 2 + 0.3, 0))
	local root = makePart("HumanoidRootPart", size, rootCf, def.color, nil, model)
	root.Transparency = 1

	local asset = findMonsterAsset(def.model) or findMonsterAsset(def.name)
	local visualRoot = asset and assetVisual(asset, root, def, model)
	if not visualRoot then
		visualRoot = blockVisual(root, def, model)
	end
	local joint = Instance.new("Motor6D")
	joint.Name = "Visual"
	joint.Part0 = root
	joint.Part1 = visualRoot
	joint.C0 = root.CFrame:ToObjectSpace(visualRoot.CFrame)
	joint.Parent = root

	-- cabeça invisível para o nome e a barra de vida aparecerem
	if not model:FindFirstChild("Head") then
		local anchorHead = makePart("Head", Vector3.one, rootCf * CFrame.new(0, size.Y / 2 + 1.5, 0), def.color, nil, model)
		anchorHead.Transparency = 1
		visualPart(anchorHead)
		weld(root, anchorHead)
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 0.3
	humanoid.MaxHealth = def.hp
	humanoid.Health = def.hp
	humanoid.WalkSpeed = def.speed
	humanoid.BreakJointsOnDeath = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	humanoid.NameDisplayDistance = def.boss and 200 or 40
	humanoid.HealthDisplayDistance = def.boss and 200 or 60
	humanoid.HealthDisplayType = def.boss and Enum.HumanoidHealthDisplayType.AlwaysOn or Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	humanoid.Parent = model

	model.PrimaryPart = root
	return model, root, humanoid
end

local function flatDistance(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

local function playersNear(run, pos, radius)
	local list = {}
	for player, state in run.players do
		if state.active then
			local root = Registry.GetRoot(player)
			if root and flatDistance(root.Position, pos) <= radius + 1.5 and math.abs(root.Position.Y - pos.Y) < 10 then
				table.insert(list, player)
			end
		end
	end
	return list
end

local function nearestPlayer(enemy)
	local best, bestRoot, bestDist = nil, nil, math.huge
	local pos = enemy.root.Position
	for player, state in enemy.run.players do
		if state.active then
			local root, humanoid = Registry.GetRoot(player)
			if root and humanoid and humanoid.Health > 0 then
				local dist = (root.Position - pos).Magnitude
				if dist < bestDist then
					best, bestRoot, bestDist = player, root, dist
				end
			end
		end
	end
	return best, bestRoot, bestDist
end

local function ground(enemy, pos)
	return Vector3.new(pos.X, enemy.run.floorY, pos.Z)
end

-- contador lido pelo cliente para disparar animações (investida, recuo...)
local function bump(enemy, attribute)
	enemy.model:SetAttribute(attribute, (enemy.model:GetAttribute(attribute) or 0) + 1)
end

local function hitPlayer(enemy, player, amount)
	bump(enemy, "Attack")
	local dealt = Registry.DamagePlayer(player, amount)
	local state = Registry.ByPlayer[player]
	if state and state.reflect > 0 and os.clock() < state.reflectUntil and not enemy.dead then
		EnemyService.Damage(enemy, amount * state.reflect, player, REFLECT)
	end
	return dealt
end

local function shoot(enemy, targetRoot)
	local run = enemy.run
	local origin = enemy.root.Position + Vector3.new(0, enemy.def.size.Y * 0.3, 0)
	local dir = targetRoot.Position - origin
	bump(enemy, "Attack")
	Projectiles.Fire({
		origin = origin,
		direction = Vector3.new(dir.X, 0, dir.Z),
		speed = enemy.def.projectileSpeed or 45,
		range = (enemy.def.range or 40) + 15,
		size = 1,
		color = ENEMY_SHOT,
		visual = "enemy",
		hitTest = function(pos, radius)
			return playersNear(run, pos, radius)
		end,
		onHit = function(player)
			hitPlayer(enemy, player, enemy.def.damage)
		end,
	})
end

-- Habilidades de chefe ------------------------------------------------------

local BossSkills = {}

function BossSkills.slam(enemy)
	local radius = enemy.radius * 2 + 10
	local center = ground(enemy, enemy.root.Position)
	enemy.castingUntil = os.clock() + 1.3
	Effects.Telegraph(center, radius, 1.2, DANGER)
	task.delay(1.2, function()
		if enemy.dead then
			return
		end
		bump(enemy, "Attack")
		Effects.Burst(center, radius, enemy.def.color, 0.4)
		Effects.Ring(center, radius * 1.2, DANGER, 0.5)
		Effects.Shake(center, 0.7, 70)
		for _, player in playersNear(enemy.run, center, radius) do
			hitPlayer(enemy, player, enemy.def.damage * 1.6)
		end
	end)
end

function BossSkills.volley(enemy)
	for player, state in enemy.run.players do
		local root = state.active and Registry.GetRoot(player)
		if root then
			local center = ground(enemy, root.Position)
			Effects.Strike(center, 7, 1.3, DANGER, "meteor")
			task.delay(1.3, function()
				if enemy.dead then
					return
				end
				for _, hit in playersNear(enemy.run, center, 7) do
					hitPlayer(enemy, hit, enemy.def.damage)
				end
			end)
		end
	end
end

function BossSkills.ring(enemy)
	enemy.castingUntil = os.clock() + 1.6
	for wave = 0, 2 do
		if enemy.dead then
			return
		end
		local origin = enemy.root.Position
		for i = 0, 15 do
			local angle = (i / 16) * math.pi * 2 + wave * math.rad(11.25)
			local run = enemy.run
			Projectiles.Fire({
				origin = origin,
				direction = Vector3.new(math.cos(angle), 0, math.sin(angle)),
				speed = 35,
				range = 90,
				size = 1.6,
				color = ENEMY_SHOT,
				visual = "enemy",
				hitTest = function(pos, radius)
					return playersNear(run, pos, radius)
				end,
				onHit = function(player)
					hitPlayer(enemy, player, enemy.def.damage * 0.7)
				end,
			})
		end
		task.wait(0.5)
	end
end

function BossSkills.summon(enemy)
	local run = enemy.run
	enemy.castingUntil = os.clock() + 1
	Effects.Burst(enemy.root.Position, 14, enemy.def.color, 0.6)
	local count = 3 + run:PlayerCount()
	for _ = 1, count do
		local offset = Vector3.new(math.random(-12, 12), 0, math.random(-12, 12))
		run:SpawnMob("chaser", run.def.waves, ground(enemy, enemy.root.Position + offset))
	end
end

function BossSkills.charge(enemy, _, targetRoot)
	local from = ground(enemy, enemy.root.Position)
	local to = ground(enemy, targetRoot.Position)
	local dir = to - from
	if dir.Magnitude < 1 then
		return
	end
	local finish = from + dir.Unit * math.min(dir.Magnitude + 15, 80)
	enemy.castingUntil = os.clock() + 0.8
	Effects.Beam(from + Vector3.new(0, 0.2, 0), finish + Vector3.new(0, 0.2, 0), enemy.radius * 2, DANGER, 0.8)
	task.delay(0.8, function()
		if enemy.dead then
			return
		end
		enemy.chargeUntil = os.clock() + 1
		enemy.humanoid:MoveTo(finish)
	end)
end

-- IA -------------------------------------------------------------------------

local function stepEnemy(enemy, now)
	local root, humanoid, def = enemy.root, enemy.humanoid, enemy.def
	if not root.Parent or root.Position.Y < enemy.run.floorY - 30 then
		EnemyService.Kill(enemy, true)
		return
	end

	if now < enemy.frozenUntil or now < enemy.castingUntil then
		humanoid.WalkSpeed = 0
		return
	end

	local player, targetRoot, dist = nearestPlayer(enemy)

	if now < enemy.chargeUntil then
		humanoid.WalkSpeed = def.speed * 5
		if player and dist <= enemy.radius + 4 and now - enemy.lastAttack >= def.attackCd then
			enemy.lastAttack = now
			hitPlayer(enemy, player, def.damage * 1.5)
		end
		return
	end

	local speedMult = now < enemy.slowUntil and enemy.slowMult or 1
	humanoid.WalkSpeed = def.speed * speedMult

	if not player then
		humanoid:MoveTo(root.Position)
		return
	end

	if def.boss and now - enemy.lastSkill >= def.skillCd then
		enemy.lastSkill = now
		local skill = BossSkills[def.skills[math.random(#def.skills)]]
		if skill then
			task.defer(skill, enemy, player, targetRoot)
		end
	end

	if def.ranged then
		if dist > def.range * 0.8 then
			humanoid:MoveTo(targetRoot.Position)
		else
			humanoid:MoveTo(root.Position)
			root.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z))
		end
		if dist <= def.range and now - enemy.lastAttack >= def.attackCd then
			enemy.lastAttack = now
			shoot(enemy, targetRoot)
		end
	else
		humanoid:MoveTo(targetRoot.Position)
		local reach = (def.reach or 2) + enemy.radius + 1.5
		if dist <= reach and now - enemy.lastAttack >= def.attackCd then
			enemy.lastAttack = now
			hitPlayer(enemy, player, def.damage)
		end
	end
end

local accumulator = 0
RunService.Heartbeat:Connect(function(dt)
	accumulator += dt
	if accumulator < AI_STEP then
		return
	end
	accumulator = 0
	local now = os.clock()
	-- cópia, porque inimigos podem morrer/nascer durante o passo
	local list = {}
	for enemy in active do
		table.insert(list, enemy)
	end
	for _, enemy in list do
		if not enemy.dead then
			local ok, err = pcall(stepEnemy, enemy, now)
			if not ok then
				warn("[EnemyService] " .. tostring(err))
			end
		end
	end
end)

-- API --------------------------------------------------------------------------

function EnemyService.Spawn(run, def, position)
	local model, root, humanoid = buildModel(def, position)
	local enemy = {
		def = def,
		run = run,
		model = model,
		root = root,
		humanoid = humanoid,
		radius = math.max(def.size.X, def.size.Z) / 2,
		dead = false,
		lastAttack = 0,
		lastSkill = os.clock(),
		slowUntil = 0,
		slowMult = 1,
		frozenUntil = 0,
		castingUntil = 0,
		chargeUntil = 0,
		lastHitBy = nil,
	}
	model:SetAttribute("Boss", def.boss == true)
	model.Parent = run.enemyFolder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	CollectionService:AddTag(model, "Enemy")
	run.enemies[enemy] = true
	active[enemy] = true
	Effects.Send("spawn", { pos = position, size = def.size.X, color = run.def.theme.accent, boss = def.boss == true })
	return enemy
end

function EnemyService.Damage(enemy, amount, player, color)
	if enemy.dead then
		return 0
	end
	amount = math.max(1, math.floor(amount + 0.5))
	local humanoid = enemy.humanoid
	humanoid.Health = math.max(0, humanoid.Health - amount)
	if player then
		enemy.lastHitBy = player
	end
	bump(enemy, "Hit")
	enemy.run:DamageNumber(enemy.root.Position + Vector3.new(0, enemy.def.size.Y / 2, 0), amount, color)
	if humanoid.Health <= 0 then
		EnemyService.Kill(enemy)
	end
	return amount
end

-- silent = true: remove sem dar XP/recompensa (fim da run, caiu do mapa...)
function EnemyService.Kill(enemy, silent)
	if enemy.dead then
		return
	end
	enemy.dead = true
	active[enemy] = nil
	enemy.run.enemies[enemy] = nil
	if not silent then
		enemy.run:OnEnemyKilled(enemy)
	end
	local model = enemy.model
	if model.Parent then
		if not silent then
			Effects.Kill(enemy.root.Position, enemy.radius, enemy.def.color, enemy.lastHitBy, enemy.def.boss == true)
		end
		-- o cliente faz a animação de queda; aqui só desliga a colisão e some depois
		model:SetAttribute("Dead", true)
		enemy.root.Anchored = true
		for _, descendant in model:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.CanCollide = false
				descendant.CanQuery = false
			end
		end
		Debris:AddItem(model, 0.7)
	end
end

function EnemyService.Slow(enemy, mult, duration)
	if enemy.dead then
		return
	end
	local now = os.clock()
	local current = now < enemy.slowUntil and enemy.slowMult or 1
	enemy.slowMult = math.min(current, mult)
	enemy.slowUntil = math.max(enemy.slowUntil, now + duration)
end

function EnemyService.Freeze(enemy, duration)
	if enemy.dead then
		return
	end
	if enemy.def.boss then
		duration *= 0.3
	end
	enemy.frozenUntil = math.max(enemy.frozenUntil, os.clock() + duration)
	local ice = Effects.Part(Enum.PartType.Block, enemy.def.size + Vector3.one * 0.8, enemy.root.CFrame, ICE, 0.5, "ice")
	ice.Material = Enum.Material.Ice
	Debris:AddItem(ice, duration)
end

-- força positiva empurra para longe de `fromPos`, negativa puxa para ele
function EnemyService.Push(enemy, fromPos, force)
	if enemy.dead then
		return
	end
	if enemy.def.boss then
		force *= 0.15
	end
	local delta = Vector3.new(enemy.root.Position.X - fromPos.X, 0, enemy.root.Position.Z - fromPos.Z)
	if delta.Magnitude < 1 then
		return
	end
	enemy.root.AssemblyLinearVelocity = delta.Unit * force + Vector3.new(0, math.abs(force) * 0.15, 0)
end

function EnemyService.GetInRadius(run, pos, radius)
	local list = {}
	if not run then
		return list
	end
	for enemy in run.enemies do
		if not enemy.dead then
			local p = enemy.root.Position
			if flatDistance(p, pos) <= radius + enemy.radius and math.abs(p.Y - pos.Y) <= 15 then
				table.insert(list, enemy)
			end
		end
	end
	return list
end

function EnemyService.Nearest(run, pos, maxDist)
	local best, bestDist = nil, maxDist
	if not run then
		return nil
	end
	for enemy in run.enemies do
		if not enemy.dead then
			local dist = flatDistance(enemy.root.Position, pos)
			if dist <= bestDist then
				best, bestDist = enemy, dist
			end
		end
	end
	return best
end

return EnemyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">LobbyService</string>
            <string name="Source"><![CDATA[-- Fila dos portais: quem fica em cima da plataforma entra junto na masmorra (party de até 4).
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.Game)
local Dungeons = require(ReplicatedStorage.Shared.Config.Dungeons)
local Net = require(ReplicatedStorage.Shared.Net)

local Registry = require(script.Parent.Registry)
local DataService = require(script.Parent.DataService)
local DungeonService = require(script.Parent.DungeonService)

local LobbyService = {}

local TICK = 0.25

local queues = {} -- [pad] = { countdownEnd, label }
local lastLockedWarning = {}

local function makeLabel(pad)
	local gui = Instance.new("BillboardGui")
	gui.Name = "QueueInfo"
	gui.Size = UDim2.fromOffset(300, 50)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
	gui.MaxDistance = 120
	gui.Parent = pad
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 18
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	return label
end

local function register(pad)
	if queues[pad] then
		return
	end
	queues[pad] = { countdownEnd = nil, label = makeLabel(pad) }
end

local function warnLocked(player, index)
	local now = os.clock()
	if lastLockedWarning[player] and now - lastLockedWarning[player] < 3 then
		return
	end
	lastLockedWarning[player] = now
	Net.Notify:FireClient(player, "Portal bloqueado", "Derrote o chefe de " .. Dungeons[index - 1].name .. " primeiro")
end

local function playersOnPad(pad, index)
	local radius = pad:GetAttribute("Radius") or 8
	local inside = {}
	for _, player in Players:GetPlayers() do
		if not Registry.ByPlayer[player] then
			local root, humanoid = Registry.GetRoot(player)
			if root and humanoid and humanoid.Health > 0 then
				local offset = root.Position - pad.Position
				if Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and math.abs(offset.Y) < 8 then
					if DataService.GetCleared(player) >= index - 1 then
						if #inside < GameConfig.MaxPartySize then
							table.insert(inside, player)
						end
					else
						warnLocked(player, index)
					end
				end
			end
		end
	end
	return inside
end

local function step()
	local now = os.clock()
	for pad, queue in queues do
		if not pad.Parent then
			queues[pad] = nil
			continue
		end
		local index = pad:GetAttribute("DungeonIndex")
		local def = Dungeons[index]
		if not def then
			continue
		end
		local inside = playersOnPad(pad, index)
		local requirement = index > 1 and ("Requer: vencer " .. Dungeons[index - 1].name) or "Aberto para todos"

		if #inside == 0 then
			queue.countdownEnd = nil
			queue.label.Text = def.name .. "\n" .. requirement
		else
			queue.countdownEnd = queue.countdownEnd or (now + GameConfig.QueueCountdown)
			local left = math.max(0, math.ceil(queue.countdownEnd - now))
			queue.label.Text = string.format("%s\n%d/%d jogadores · começa em %ds", def.name, #inside, GameConfig.MaxPartySize, left)
			if now >= queue.countdownEnd then
				queue.countdownEnd = nil
				task.spawn(DungeonService.StartRun, index, inside)
			end
		end
	end
end

function LobbyService.Init()
	for _, pad in CollectionService:GetTagged("DungeonPad") do
		register(pad)
	end
	CollectionService:GetInstanceAddedSignal("DungeonPad"):Connect(register)
	Players.PlayerRemoving:Connect(function(player)
		lastLockedWarning[player] = nil
	end)

	task.spawn(function()
		while true do
			local ok, err = pcall(step)
			if not ok then
				warn("[LobbyService] " .. tostring(err))
			end
			task.wait(TICK)
		end
	end)
end

return LobbyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">PowerService</string>
            <string name="Source"><![CDATA[-- Executa os poderes (tiers 1-3 automáticos, tier 4 = ultimate manual) e o ataque básico.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Powers = require(ReplicatedStorage.Shared.Config.Powers)
local GameConfig = require(ReplicatedStorage.Shared.Config.Game)
local Effects = require(script.Parent.Effects)
local Projectiles = require(script.Parent.Projectiles)
local EnemyService = require(script.Parent.EnemyService)
local Registry = require(script.Parent.Registry)

local PowerService = {}

local COMBAT_RANGE = 60 -- só dispara habilidades se houver inimigo até essa distância
local VERTICAL = Effects.VERTICAL
local FEET_OFFSET = CFrame.new(0, -2.9, 0) -- do HumanoidRootPart até o chão (R15 padrão)

-- utilidades -----------------------------------------------------------------

local function flat(v)
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 0.01 then
		return Vector3.new(0, 0, -1)
	end
	return f.Unit
end

local function ground(state, pos)
	return Vector3.new(pos.X, state.run.floorY, pos.Z)
end

local function aimPoint(root, target)
	if target and not target.dead then
		return target.root.Position
	end
	return root.Position + root.CFrame.LookVector * 25
end

local function damageMult(state)
	local mult = state.stats.damageMult
	if os.clock() < state.buffUntil then
		mult *= state.buffMult
	end
	return mult
end

local function hitEnemy(state, enemy, amount, color, t)
	if enemy.dead or not amount then
		return
	end
	local dealt = EnemyService.Damage(enemy, amount * damageMult(state), state.player, color)
	if t.lifesteal and dealt > 0 then
		Registry.HealPlayer(state.player, dealt * t.lifesteal)
	end
	if t.slow then
		EnemyService.Slow(enemy, t.slow, t.slowTime or 2)
	end
	if t.freeze then
		EnemyService.Freeze(enemy, t.freeze)
	end
end

local function aoe(state, center, radius, damage, color, t)
	for _, enemy in EnemyService.GetInRadius(state.run, center, radius) do
		hitEnemy(state, enemy, damage, color, t)
	end
end

-- direções em leque (spread em graus; 360 = círculo completo)
local function fan(baseDir, count, spreadDeg)
	if count <= 1 then
		return { baseDir }
	end
	local full = spreadDeg >= 360
	local spread = math.rad(math.min(spreadDeg, 360))
	local step = full and spread / count or spread / (count - 1)
	local start = full and 0 or -spread / 2
	local dirs = {}
	for i = 0, count - 1 do
		table.insert(dirs, CFrame.fromAxisAngle(Vector3.yAxis, start + step * i) * baseDir)
	end
	return dirs
end

local function lineHit(state, t, color, origin, dir, length, width, damage)
	Effects.Beam(origin, origin + dir * length, width, color, 0.3)
	for _, enemy in EnemyService.GetInRadius(state.run, origin + dir * (length / 2), length / 2 + width) do
		local rel = enemy.root.Position - origin
		local along = rel:Dot(dir)
		if along >= -enemy.radius and along <= length + enemy.radius then
			local perp = rel - dir * along
			if Vector3.new(perp.X, 0, perp.Z).Magnitude <= width + enemy.radius then
				hitEnemy(state, enemy, damage, color, t)
			end
		end
	end
end

-- tipos de habilidade ----------------------------------------------------------

local Kinds = {}

function Kinds.projectile(state, t, color, root, target)
	local run = state.run
	local function fireOne(origin, dir)
		Projectiles.Fire({
			origin = origin,
			direction = dir,
			speed = t.speed or 90,
			range = t.range or 70,
			size = t.size or 1.2,
			color = color,
			visual = t.visual,
			pierce = t.explode and 0 or (t.pierce or 0),
			homing = t.homing and function(pos)
				local enemy = EnemyService.Nearest(run, pos, 40)
				return enemy and enemy.root.Position
			end or nil,
			hitTest = function(pos, radius)
				return EnemyService.GetInRadius(run, pos, radius)
			end,
			onHit = function(enemy, pos)
				if t.explode then
					Effects.Burst(pos, t.explode, color)
					aoe(state, pos, t.explode, t.damage, color, t)
				else
					hitEnemy(state, enemy, t.damage, color, t)
				end
			end,
		})
	end

	task.spawn(function()
		for shot = 1, t.burst or 1 do
			if not state.active or not root.Parent then
				return
			end
			if shot > 1 then
				target = EnemyService.Nearest(run, root.Position, COMBAT_RANGE) or target
			end
			local origin = root.Position + Vector3.new(0, 0.5, 0)
			local baseDir = flat(aimPoint(root, target) - origin)
			if t.jitter then
				baseDir = CFrame.fromAxisAngle(Vector3.yAxis, math.rad((math.random() - 0.5) * t.jitter)) * baseDir
			end
			for _, dir in fan(baseDir, t.count or 1, t.spread or 25) do
				fireOne(origin, dir)
			end
			task.wait(t.burstGap or 0.1)
		end
	end)
end

function Kinds.nova(state, t, color, root, target)
	local center = (t.atTarget and target and not target.dead) and target.root.Position or root.Position
	Effects.Burst(center, t.radius, color)
	Effects.Ring(ground(state, center), t.radius, color)
	if t.radius >= 14 then
		Effects.Shake(center, math.min(0.8, t.radius / 40), t.radius * 3)
	end
	for _, enemy in EnemyService.GetInRadius(state.run, center, t.radius) do
		hitEnemy(state, enemy, t.damage, color, t)
		if t.knockback then
			EnemyService.Push(enemy, center, t.knockback)
		end
		if t.pull then
			EnemyService.Push(enemy, center, -t.pull)
		end
	end
end

local function strikeAt(state, t, color, center)
	local delay = t.delay or 0.5
	Effects.Strike(center, t.radius, delay, color, t.visual)
	task.delay(delay, function()
		if not state.active then
			return
		end
		if t.radius >= 12 then
			Effects.Shake(center, math.min(1, t.radius / 30), t.radius * 4)
		end
		aoe(state, center, t.radius, t.damage, color, t)
	end)
end

function Kinds.strike(state, t, color, root, target)
	local count = t.count or 1
	local area = t.area or 45
	task.spawn(function()
		for _ = 1, count do
			if not state.active or not root.Parent then
				return
			end
			local pos
			if count == 1 and target and not target.dead then
				pos = target.root.Position
			else
				local nearby = EnemyService.GetInRadius(state.run, root.Position, area)
				if #nearby > 0 and math.random() < 0.75 then
					pos = nearby[math.random(#nearby)].root.Position
				else
					local angle, dist = math.random() * math.pi * 2, math.random() * area
					pos = root.Position + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
				end
			end
			strikeAt(state, t, color, ground(state, pos))
			if t.interval then
				task.wait(t.interval)
			end
		end
	end)
end

function Kinds.zone(state, t, color, root, target)
	local center = ground(state, aimPoint(root, target))
	local size = Vector3.new(0.3, t.radius * 2, t.radius * 2)
	local disc = Effects.Part(Enum.PartType.Cylinder, size, CFrame.new(center) * VERTICAL, color, 0.65, t.pull and "vortex" or "zone")
	if t.follow then
		Effects.Attach(disc, root, FEET_OFFSET * VERTICAL)
	end
	Debris:AddItem(disc, t.duration + 1)
	task.spawn(function()
		local tick, elapsed = 0.5, 0
		while elapsed < t.duration and state.active and root.Parent do
			local c = t.follow and ground(state, root.Position) or center
			for _, enemy in EnemyService.GetInRadius(state.run, c, t.radius) do
				hitEnemy(state, enemy, t.dps * tick, color, t)
				if t.pull then
					EnemyService.Push(enemy, c, -t.pull)
				end
			end
			task.wait(tick)
			elapsed += tick
		end
		disc:Destroy()
	end)
end

function Kinds.orbit(state, t, color, root)
	local blades = {}
	for i = 1, t.count do
		blades[i] = Effects.Part(Enum.PartType.Block, Vector3.new(0.6, 0.6, 3), root.CFrame, color, 0, "blade")
	end
	local start = os.clock()
	local lastHit = {}
	local connection
	connection = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now - start > t.duration or not state.active or not root.Parent then
			connection:Disconnect()
			for _, blade in blades do
				blade:Destroy()
			end
			return
		end
		local center = root.Position
		for i, blade in blades do
			local angle = now * (t.spin or 3) + (i / t.count) * math.pi * 2
			local p = center + Vector3.new(math.cos(angle) * t.radius, 0, math.sin(angle) * t.radius)
			blade.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(angle), 0, math.cos(angle)))
			for _, enemy in EnemyService.GetInRadius(state.run, p, 2.5) do
				if not lastHit[enemy] or now - lastHit[enemy] >= 0.5 then
					lastHit[enemy] = now
					hitEnemy(state, enemy, t.damage, color, t)
				end
			end
		end
	end)
end

function Kinds.line(state, t, color, root, target)
	local origin = root.Position
	lineHit(state, t, color, origin, flat(aimPoint(root, target) - origin), t.length, t.width, t.damage)
end

function Kinds.beam(state, t, color, root, target)
	task.spawn(function()
		local tick, elapsed = 0.2, 0
		while elapsed < t.duration and state.active and root.Parent do
			local current = EnemyService.Nearest(state.run, root.Position, t.length) or target
			local origin = root.Position
			lineHit(state, t, color, origin, flat(aimPoint(root, current) - origin), t.length, t.width, t.dps * tick)
			task.wait(tick)
			elapsed += tick
		end
	end)
end

function Kinds.chain(state, t, color, root, target)
	local from = root.Position
	local current = target
	local hit = {}
	for _ = 1, t.jumps do
		if not current then
			break
		end
		hit[current] = true
		local pos = current.root.Position
		Effects.Bolt(from, pos, color)
		hitEnemy(state, current, t.damage, color, t)
		from = pos
		local nextTarget, bestDist = nil, t.range or 25
		for _, enemy in EnemyService.GetInRadius(state.run, pos, t.range or 25) do
			local dist = (enemy.root.Position - pos).Magnitude
			if not hit[enemy] and dist <= bestDist then
				nextTarget, bestDist = enemy, dist
			end
		end
		current = nextTarget
	end
end

function Kinds.summon(state, t, color, root)
	local run = state.run
	for _ = 1, t.count do
		local pos = ground(state, root.Position + Vector3.new(math.random(-6, 6), 0, math.random(-6, 6))) + Vector3.new(0, 1.5, 0)
		local body = Effects.Part(Enum.PartType.Block, Vector3.new(2, 3, 2), CFrame.new(pos), color, 0.25, "summon")
		Effects.Burst(pos, 4, color, 0.4)
		local start, lastHit = os.clock(), 0
		local connection
		connection = RunService.Heartbeat:Connect(function(dt)
			local now = os.clock()
			if now - start > t.duration or not state.active or not root.Parent then
				connection:Disconnect()
				if t.explode and state.active then
					Effects.Burst(pos, t.explodeRadius or 10, color)
					aoe(state, pos, t.explodeRadius or 10, t.explode, color, t)
				end
				body:Destroy()
				return
			end
			local enemy = EnemyService.Nearest(run, pos, 60)
			local goal = enemy and enemy.root.Position or root.Position
			local delta = Vector3.new(goal.X - pos.X, 0, goal.Z - pos.Z)
			local stopAt = enemy and (enemy.radius + 2) or 6
			if delta.Magnitude > stopAt then
				pos += delta.Unit * math.min(delta.Magnitude - stopAt, (t.speed or 22) * dt)
			elseif enemy and now - lastHit > 0.6 then
				lastHit = now
				hitEnemy(state, enemy, t.damage, color, t)
			end
			body.CFrame = CFrame.lookAt(pos, pos + (delta.Magnitude > 0.1 and delta.Unit or Vector3.new(0, 0, -1)))
				* CFrame.new(0, math.sin(now * 8) * 0.2, 0)
		end)
	end
end

function Kinds.shield(state, t, color, root)
	local now = os.clock()
	if now >= state.shieldUntil then
		state.shield = 0
	end
	state.shield = math.max(state.shield, t.absorb)
	state.shieldUntil = math.max(state.shieldUntil, now + t.duration)
	if t.reflect then
		state.reflect = t.reflect
		state.reflectUntil = now + t.duration
	end
	local bubble = Effects.Part(Enum.PartType.Ball, Vector3.one * 8, root.CFrame, color, 0.8, "shield")
	Effects.Attach(bubble, root)
	Debris:AddItem(bubble, t.duration)
	if t.knockback then
		Kinds.nova(state, { radius = t.radius or 10, knockback = t.knockback }, color, root, nil)
	end
end

function Kinds.heal(state, t, color, root)
	local now = os.clock()
	if t.amount then
		Registry.HealPlayer(state.player, t.amount)
	end
	if t.regen then
		state.regen = t.regen
		state.regenUntil = now + t.duration
	end
	if t.invuln then
		state.invulnUntil = math.max(state.invulnUntil, now + t.duration)
		Effects.Glow(root.Parent, color, t.duration)
	end
	Effects.Burst(root.Position, 6, color, 0.5)
end

function Kinds.buff(state, t, color, root)
	state.buffMult = t.damageMult or 1
	state.buffUntil = os.clock() + t.duration
	Effects.Glow(root.Parent, color, t.duration)
	if t.auraDps then
		Kinds.zone(state, { dps = t.auraDps, radius = t.radius or 12, duration = t.duration, follow = true }, color, root, nil)
	end
end

-- API ---------------------------------------------------------------------------

function PowerService.Cast(state, power, t, root, target)
	local kind = Kinds[t.kind]
	if not kind then
		warn("[PowerService] tipo desconhecido: " .. tostring(t.kind))
		return false
	end
	if t.kind == "chain" and not target then
		return false
	end
	if t.kind == "heal" and not t.invuln and not t.regen then
		local _, humanoid = Registry.GetRoot(state.player)
		if humanoid and humanoid.Health >= humanoid.MaxHealth then
			return false
		end
	end
	local color = power.colors and power.colors[math.random(#power.colors)] or power.color
	kind(state, t, color, root, target)
	return true
end

-- chamado todo frame para cada jogador em run: dispara habilidades prontas
function PowerService.Tick(state, now)
	local root = Registry.GetRoot(state.player)
	if not root then
		return
	end
	local nearest, searched = nil, false
	for _, owned in state.powers do
		local power = Powers.ById[owned.id]
		for tierIndex = 1, math.min(owned.tier, 3) do
			local key = owned.id .. tierIndex
			if now >= (state.cooldowns[key] or 0) then
				if not searched then
					nearest = EnemyService.Nearest(state.run, root.Position, COMBAT_RANGE)
					searched = true
				end
				if not nearest then
					return
				end
				local t = power.tiers[tierIndex]
				if PowerService.Cast(state, power, t, root, nearest) then
					state.cooldowns[key] = now + t.cd * state.stats.cooldownMult
				end
			end
		end
	end
end

function PowerService.CastUltimate(state, slot)
	local owned = state.powers[slot]
	if not owned or owned.tier < 4 then
		return false
	end
	local key = owned.id .. "ult"
	local now = os.clock()
	if now < (state.cooldowns[key] or 0) then
		return false
	end
	local root = Registry.GetRoot(state.player)
	if not root then
		return false
	end
	local power = Powers.ById[owned.id]
	local t = power.tiers[4]
	local target = EnemyService.Nearest(state.run, root.Position, 90)
	if not PowerService.Cast(state, power, t, root, target) then
		return false
	end
	state.cooldowns[key] = now + t.cd * state.stats.cooldownMult
	Effects.Glow(root.Parent, power.color, 1.5)
	Effects.Burst(root.Position, 10, power.color, 0.5)
	Effects.Shake(root.Position, 0.5, 80)
	return true, t.name
end

-- Combo de 3 golpes: corte da direita, corte da esquerda, golpe por cima (mais forte, em área).
function PowerService.BasicAttack(state, direction)
	local config = GameConfig.BasicAttack
	local now = os.clock()
	if now - state.lastBasic < config.cooldown then
		return
	end
	if now - state.lastBasic > config.comboReset then
		state.combo = 0
	end
	state.lastBasic = now
	state.combo = (state.combo or 0) % #config.combo + 1
	local step = config.combo[state.combo]

	local root = Registry.GetRoot(state.player)
	if not root then
		return
	end
	local dir = flat(direction)
	local origin = root.Position
	local range = config.range * step.range
	Effects.Swing(state.player, state.combo, origin, dir, range, config.color)

	-- o dano entra no meio da animação do golpe
	task.delay(step.hitDelay, function()
		if not state.active or not root.Parent then
			return
		end
		local hitAny = false
		for _, enemy in EnemyService.GetInRadius(state.run, root.Position, range) do
			local toEnemy = enemy.root.Position - root.Position
			if flat(toEnemy):Dot(dir) > step.arc or toEnemy.Magnitude < enemy.radius + 3 then
				hitEnemy(state, enemy, config.damage * step.damage, config.color, {})
				EnemyService.Push(enemy, root.Position, step.knockback)
				hitAny = true
			end
		end
		if step.slam then
			local g = ground(state, root.Position + dir * 5)
			Effects.Ring(g, range, config.color, 0.35)
			Effects.Shake(g, 0.35, 30)
		elseif hitAny then
			Effects.Shake(root.Position, 0.12, 15)
		end
	end)
end

return PowerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Projectiles</string>
            <string name="Source"><![CDATA[-- Projéteis simulados no servidor (usados por poderes e por inimigos).
local RunService = game:GetService("RunService")

local Effects = require(script.Parent.Effects)

local Projectiles = {}

--[[
	options:
	  origin, direction, speed, range, size, color
	  visual     como o cliente desenha: "orb" (padrão), "blade", "bullet", "lance", "wind", "fireball", "enemy"
	  pierce     quantos alvos extras atravessa (0 = some no primeiro)
	  homing     function(pos) -> Vector3? alvo para curvar
	  hitTest    function(pos, radius) -> lista de alvos perto
	  onHit      function(alvo, pos)
]]
function Projectiles.Fire(options)
	local direction = options.direction
	if direction.Magnitude < 0.01 then
		direction = Vector3.new(0, 0, -1)
	end
	local dir = direction.Unit
	local pos = options.origin
	local size = options.size or 1
	local part = Effects.Part(Enum.PartType.Ball, Vector3.one * size, CFrame.lookAt(pos, pos + dir), options.color, 0, options.visual or "orb")
	local traveled = 0
	local pierceLeft = options.pierce or 0
	local hits = {}

	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		if options.homing then
			local targetPos = options.homing(pos)
			if targetPos then
				local want = Vector3.new(targetPos.X - pos.X, 0, targetPos.Z - pos.Z)
				if want.Magnitude > 0.5 then
					local turned = dir:Lerp(want.Unit, math.clamp(dt * 6, 0, 1))
					if turned.Magnitude > 0.01 then
						dir = turned.Unit
					end
				end
			end
		end

		local step = options.speed * dt
		pos += dir * step
		traveled += step
		part.CFrame = CFrame.lookAt(pos, pos + dir) -- orientado: o cliente desenha lâminas/lanças apontando para a frente

		for _, target in options.hitTest(pos, size / 2 + 1.5) do
			if not hits[target] then
				hits[target] = true
				options.onHit(target, pos)
				pierceLeft -= 1
				if pierceLeft < 0 then
					traveled = math.huge
					break
				end
			end
		end

		if traveled >= options.range or not part.Parent then
			connection:Disconnect()
			part:Destroy()
		end
	end)
end

return Projectiles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Registry</string>
            <string name="Source"><![CDATA[-- Quem está em qual run, e dano/cura em jogadores (considera escudo e invencibilidade).
local Registry = {
	ByPlayer = {}, -- [Player] = estado do jogador na run (criado em DungeonService)
}

function Registry.GetRoot(player)
	local character = player.Character
	if not character then
		return nil, nil
	end
	return character:FindFirstChild("HumanoidRootPart"), character:FindFirstChildOfClass("Humanoid")
end

function Registry.DamagePlayer(player, amount)
	local _, humanoid = Registry.GetRoot(player)
	if not humanoid or humanoid.Health <= 0 then
		return 0
	end
	local state = Registry.ByPlayer[player]
	if state then
		local now = os.clock()
		if now < state.invulnUntil then
			return 0
		end
		if state.shield > 0 and now < state.shieldUntil then
			local absorbed = math.min(state.shield, amount)
			state.shield -= absorbed
			amount -= absorbed
		end
	end
	if amount > 0 then
		humanoid:TakeDamage(amount)
	end
	return amount
end

function Registry.HealPlayer(player, amount)
	local _, humanoid = Registry.GetRoot(player)
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
	end
end

return Registry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">WeaponService</string>
            <string name="Source"><![CDATA[-- Coloca a arma na mão direita de todo personagem que nasce.
-- A arma fica presa por um Motor6D "WeaponGrip" na RightHand: o cliente gira essa junta
-- durante os golpes (client/Controllers/Animator.luau).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.Game)

local WeaponService = {}

local BLADE = Color3.fromRGB(205, 212, 225)
local GOLD = Color3.fromRGB(230, 180, 70)
local LEATHER = Color3.fromRGB(70, 40, 30)
local GLOW = Color3.fromRGB(140, 210, 255)

local function weaponPart(model, name, size, cframe, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.Parent = model
	return part
end

-- Espada feita de Parts. Origem = centro do cabo; a lâmina sobe no eixo +Y.
local function buildDefaultSword()
	local model = Instance.new("Model")
	model.Name = "Weapon"
	local length = GameConfig.Weapon.Length
	local origin = CFrame.new()

	local handle = weaponPart(model, "Handle", Vector3.new(0.28, 1.1, 0.28), origin, LEATHER, Enum.Material.Fabric)
	weaponPart(model, "Pommel", Vector3.new(0.42, 0.42, 0.42), origin * CFrame.new(0, -0.65, 0), GOLD, Enum.Material.Metal).Shape = Enum.PartType.Ball
	weaponPart(model, "Guard", Vector3.new(1.5, 0.22, 0.32), origin * CFrame.new(0, 0.62, 0), GOLD, Enum.Material.Metal)
	local bladeLength = length - 1.4
	local blade = weaponPart(model, "Blade", Vector3.new(0.5, bladeLength, 0.1), origin * CFrame.new(0, 0.73 + bladeLength / 2, 0), BLADE, Enum.Material.Metal)
	blade.Reflectance = 0.25
	weaponPart(model, "Fuller", Vector3.new(0.12, bladeLength * 0.85, 0.12), blade.CFrame * CFrame.new(0, -bladeLength * 0.05, 0), GLOW, Enum.Material.Neon)
	weaponPart(model, "Tip", Vector3.new(0.354, 0.354, 0.1), origin * CFrame.new(0, 0.73 + bladeLength, 0) * CFrame.Angles(0, 0, math.rad(45)), BLADE, Enum.Material.Metal)

	model.PrimaryPart = handle
	return model
end

-- Modelo importado: escala para o comprimento configurado; o pivô do modelo vira o ponto da empunhadura.
local function buildImportedSword(asset)
	local model = asset:Clone()
	model.Name = "Weapon"
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.Massless = true
		elseif descendant:IsA("BaseScript") then
			descendant:Destroy()
		end
	end
	local _, size = model:GetBoundingBox()
	local longest = math.max(size.X, size.Y, size.Z)
	if longest > 0.01 then
		model:ScaleTo(model:GetScale() * GameConfig.Weapon.Length / longest)
	end
	local handle = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not handle then
		model:Destroy()
		return nil
	end
	-- o "Handle" fica no pivô do modelo para a junta usar esse ponto
	local pivot = model:GetPivot()
	local gripPart = weaponPart(model, "Handle", Vector3.new(0.2, 0.2, 0.2), pivot, BLADE, Enum.Material.SmoothPlastic)
	gripPart.Transparency = 1
	model.PrimaryPart = gripPart
	return model
end

local function weld(a, b)
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = a
	constraint.Part1 = b
	constraint.Parent = a
end

local function equip(character)
	local hand = character:WaitForChild("RightHand", 10)
	if not hand or character:FindFirstChild("Weapon") then
		return
	end

	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local weapons = assets and assets:FindFirstChild("Weapons")
	local asset = weapons and weapons:FindFirstChild(GameConfig.Weapon.Model)
	local model = asset and buildImportedSword(asset) or buildDefaultSword()
	local handle = model.PrimaryPart

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= handle then
			weld(handle, descendant)
		end
	end

	-- lâmina apontando para a frente com o braço solto
	local grip = Instance.new("Motor6D")
	grip.Name = "WeaponGrip"
	grip.Part0 = hand
	grip.Part1 = handle
	grip.C0 = CFrame.new(0, -0.2, 0) * CFrame.Angles(math.rad(-90), 0, 0) * GameConfig.Weapon.GripOffset
	grip.Parent = hand

	model.Parent = character
end

function WeaponService.Init()
	local function onPlayer(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(equip, character)
		end)
		if player.Character then
			task.spawn(equip, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return WeaponService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[-- Gera o lobby e as arenas das masmorras com Parts.
-- Se você montar o seu próprio lobby no Studio (um Model chamado "Lobby" no Workspace),
-- o gerado é ignorado: basta marcar as plataformas com a tag "DungeonPad"
-- e o atributo DungeonIndex (1, 2, 3...) e opcionalmente Radius.
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Dungeons = require(ReplicatedStorage.Shared.Config.Dungeons)

local WorldBuilder = {}

local VERTICAL = CFrame.Angles(0, 0, math.rad(90))

local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		p[key] = value
	end
	p.Parent = parent
	return p
end

local function light(parent, color, range, brightness)
	local pointLight = Instance.new("PointLight")
	pointLight.Color = color
	pointLight.Range = range or 16
	pointLight.Brightness = brightness or 1.5
	pointLight.Parent = parent
end

local function billboard(adornee, lines, height)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(320, 26 * #lines)
	gui.StudsOffset = Vector3.new(0, height or 4, 0)
	gui.MaxDistance = 150
	gui.Parent = adornee
	for i, line in lines do
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 0, 26)
		label.Position = UDim2.fromOffset(0, (i - 1) * 26)
		label.Font = Enum.Font.GothamBlack
		label.TextSize = line.size or 20
		label.TextColor3 = line.color or Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0.3
		label.Text = line.text
		label.Parent = gui
	end
	return gui
end

local function tree(parent, pos, scale, leafColor)
	part(parent, {
		Name = "Trunk",
		Size = Vector3.new(1.6, 8, 1.6) * scale,
		CFrame = CFrame.new(pos + Vector3.new(0, 4 * scale, 0)),
		Color = Color3.fromRGB(100, 70, 45),
		Material = Enum.Material.Wood,
	})
	part(parent, {
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 8 * scale,
		CFrame = CFrame.new(pos + Vector3.new(0, 9.5 * scale, 0)),
		Color = leafColor,
		Material = Enum.Material.Grass,
	})
end

local function lamp(parent, pos)
	part(parent, {
		Name = "LampPost",
		Size = Vector3.new(0.8, 10, 0.8),
		CFrame = CFrame.new(pos + Vector3.new(0, 5, 0)),
		Color = Color3.fromRGB(50, 45, 40),
		Material = Enum.Material.Metal,
	})
	local bulb = part(parent, {
		Name = "Lamp",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.8,
		CFrame = CFrame.new(pos + Vector3.new(0, 10.5, 0)),
		Color = Color3.fromRGB(255, 200, 120),
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	light(bulb, Color3.fromRGB(255, 200, 120), 24, 1.5)
end

local function portal(parent, def, index, cframe)
	local theme = def.theme
	local model = Instance.new("Model")
	model.Name = "Portal_" .. def.id
	model.Parent = parent

	part(model, { Name = "Base", Size = Vector3.new(20, 1.5, 8), CFrame = cframe * CFrame.new(0, 0.75, 0), Color = theme.wall, Material = theme.wallMaterial })
	for _, side in { -1, 1 } do
		part(model, { Name = "Pillar", Size = Vector3.new(2.5, 18, 2.5), CFrame = cframe * CFrame.new(side * 7.5, 10, 0), Color = theme.wall, Material = theme.wallMaterial })
	end
	local top = part(model, { Name = "Top", Size = Vector3.new(19, 3, 3), CFrame = cframe * CFrame.new(0, 20, 0), Color = theme.wall, Material = theme.wallMaterial })
	local surface = part(model, {
		Name = "PortalSurface",
		Size = Vector3.new(12.5, 16.5, 0.6),
		CFrame = cframe * CFrame.new(0, 10, 0),
		Color = theme.accent,
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
	})
	light(surface, theme.accent, 30, 2)
	local particles = Instance.new("ParticleEmitter")
	particles.Color = ColorSequence.new(theme.accent)
	particles.LightEmission = 1
	particles.Rate = 20
	particles.Lifetime = NumberRange.new(1, 2)
	particles.Speed = NumberRange.new(1, 3)
	particles.Size = NumberSequence.new(0.4, 0)
	particles.Parent = surface

	billboard(top, {
		{ text = "W" .. index .. " · " .. def.name, size = 22, color = theme.accent },
		{ text = "Chefe: " .. def.boss.name, size = 16 },
	}, 4)

	-- plataforma da fila, na frente do portal
	local pad = part(model, {
		Name = "Pad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 16, 16),
		CFrame = cframe * CFrame.new(0, 0.3, -12) * VERTICAL,
		Color = theme.accent,
		Material = Enum.Material.Neon,
		Transparency = 0.45,
		CanCollide = false,
	})
	pad:SetAttribute("DungeonIndex", index)
	pad:SetAttribute("Radius", 8)
	CollectionService:AddTag(pad, "DungeonPad")
end

function WorldBuilder.SetupLighting()
	Lighting.ClockTime = 16.8
	Lighting.Brightness = 2.2
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 130, 120)

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Haze = 1
	atmosphere.Color = Color3.fromRGB(200, 180, 160)
	atmosphere.Parent = Lighting

	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 24
	bloom.Threshold = 1
	bloom.Parent = Lighting

	local grading = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	grading.Saturation = 0.15
	grading.Contrast = 0.08
	grading.Parent = Lighting
end

function WorldBuilder.BuildLobby()
	if workspace:FindFirstChild("Lobby") then
		return -- lobby feito à mão no Studio
	end
	local lobby = Instance.new("Model")
	lobby.Name = "Lobby"

	part(lobby, { Name = "Ground", Size = Vector3.new(400, 4, 400), CFrame = CFrame.new(0, -2, 0), Color = Color3.fromRGB(86, 140, 70), Material = Enum.Material.Grass })
	part(lobby, {
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 100, 100),
		CFrame = CFrame.new(0, 0.2, 0) * VERTICAL,
		Color = Color3.fromRGB(150, 145, 135),
		Material = Enum.Material.Cobblestone,
	})
	part(lobby, {
		Name = "Path",
		Size = Vector3.new(14, 0.4, 70),
		CFrame = CFrame.new(0, 0.21, -60),
		Color = Color3.fromRGB(150, 145, 135),
		Material = Enum.Material.Cobblestone,
	})

	if not workspace:FindFirstChildOfClass("SpawnLocation") then
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "LobbySpawn"
		spawn.Size = Vector3.new(10, 1, 10)
		spawn.CFrame = CFrame.new(0, 0.5, 20)
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Color = Color3.fromRGB(235, 190, 90)
		spawn.Material = Enum.Material.SmoothPlastic
		spawn.TopSurface = Enum.SurfaceType.Smooth
		spawn.Parent = lobby
	end

	-- cristal central
	local crystal = part(lobby, {
		Name = "Crystal",
		Size = Vector3.new(4, 12, 4),
		CFrame = CFrame.new(0, 9, -8) * CFrame.Angles(0, math.rad(45), 0),
		Color = Color3.fromRGB(140, 200, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.2,
		CanCollide = false,
	})
	part(lobby, { Name = "CrystalBase", Size = Vector3.new(8, 3, 8), CFrame = CFrame.new(0, 1.5, -8), Color = Color3.fromRGB(90, 85, 80), Material = Enum.Material.Slate })
	light(crystal, Color3.fromRGB(140, 200, 255), 40, 2)
	billboard(crystal, {
		{ text = "PORTAIS DO ABISMO", size = 28, color = Color3.fromRGB(235, 190, 90) },
		{ text = "Pise na plataforma de um portal para entrar", size = 16 },
	}, 9)

	-- portais em arco no lado norte
	local count = #Dungeons
	for i, def in Dungeons do
		local angle = count > 1 and math.rad(-60 + (i - 1) * 120 / (count - 1)) or 0
		local pos = Vector3.new(math.sin(angle) * 75, 0, -math.cos(angle) * 75)
		portal(lobby, def, i, CFrame.lookAt(pos, Vector3.new(0, 0, 0)))
	end

	-- decoração
	local rng = Random.new(42)
	for _ = 1, 45 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(100, 185)
		local pos = Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
		tree(lobby, pos, rng:NextNumber(0.9, 1.6), Color3.fromRGB(60 + rng:NextInteger(0, 30), 120 + rng:NextInteger(0, 40), 50))
	end
	for i = 0, 7 do
		local angle = i / 8 * math.pi * 2
		lamp(lobby, Vector3.new(math.cos(angle) * 52, 0, math.sin(angle) * 52))
	end

	-- paredes invisíveis
	for _, wall in {
		{ Vector3.new(400, 60, 2), Vector3.new(0, 30, 200) },
		{ Vector3.new(400, 60, 2), Vector3.new(0, 30, -200) },
		{ Vector3.new(2, 60, 400), Vector3.new(200, 30, 0) },
		{ Vector3.new(2, 60, 400), Vector3.new(-200, 30, 0) },
	} do
		part(lobby, { Name = "Boundary", Size = wall[1], CFrame = CFrame.new(wall[2]), Transparency = 1 })
	end

	lobby.Parent = workspace
end

-- Arena de uma run. Retorna dados usados pelo DungeonService.
function WorldBuilder.BuildArena(def, origin)
	local theme = def.theme
	local model = Instance.new("Model")
	model.Name = "Arena_" .. def.id

	local size, height = 220, 24
	part(model, { Name = "Floor", Size = Vector3.new(size, 4, size), CFrame = CFrame.new(origin - Vector3.new(0, 2, 0)), Color = theme.floor, Material = theme.floorMaterial })
	for _, wall in {
		{ Vector3.new(size, height, 4), Vector3.new(0, height / 2, size / 2) },
		{ Vector3.new(size, height, 4), Vector3.new(0, height / 2, -size / 2) },
		{ Vector3.new(4, height, size), Vector3.new(size / 2, height / 2, 0) },
		{ Vector3.new(4, height, size), Vector3.new(-size / 2, height / 2, 0) },
	} do
		part(model, { Name = "Wall", Size = wall[1], CFrame = CFrame.new(origin + wall[2]), Color = theme.wall, Material = theme.wallMaterial })
	end
	-- teto invisível para ninguém pular para fora
	part(model, { Name = "Ceiling", Size = Vector3.new(size, 2, size), CFrame = CFrame.new(origin + Vector3.new(0, 60, 0)), Transparency = 1 })

	-- colunas com tochas (deixa o centro livre para o chefe)
	local rng = Random.new()
	for _ = 1, 10 do
		local x, z = rng:NextNumber(-75, 75), rng:NextNumber(-75, 75)
		if math.abs(x) > 25 or math.abs(z) > 25 then
			local width, h = rng:NextNumber(4, 8), rng:NextNumber(6, 16)
			part(model, { Name = "Pillar", Size = Vector3.new(width, h, width), CFrame = CFrame.new(origin + Vector3.new(x, h / 2, z)), Color = theme.wall, Material = theme.wallMaterial })
			local torch = part(model, {
				Name = "Torch",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 1.6,
				CFrame = CFrame.new(origin + Vector3.new(x, h + 0.8, z)),
				Color = theme.accent,
				Material = Enum.Material.Neon,
				CanCollide = false,
			})
			light(torch, theme.accent, 30, 2)
		end
	end

	local spawnPoints = {}
	for i = 1, 16 do
		local angle = i / 16 * math.pi * 2
		table.insert(spawnPoints, origin + Vector3.new(math.cos(angle) * 92, 0, math.sin(angle) * 92))
	end

	model.Parent = workspace
	return {
		model = model,
		floorY = origin.Y,
		center = origin,
		playerSpawn = origin + Vector3.new(0, 0, 40),
		spawnPoints = spawnPoints,
	}
end

return WorldBuilder
]]></string>
