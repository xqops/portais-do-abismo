			{ name = "Trono das Mil Espadas", desc = "Chuva de espadas por toda a área.", kind = "strike", visual = "sword", cd = 50, damage = 60, radius = 9, count = 24, interval = 0.08, delay = 0.5, area = 60 },
		},
	},
	{
		id = "void",
		name = "Teleporte",
